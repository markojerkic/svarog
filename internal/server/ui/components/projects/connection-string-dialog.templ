package projectcomponents

import "github.com/markojerkic/svarog/internal/server/ui/components/dialog"
import "github.com/markojerkic/svarog/internal/server/ui/components/button"
import "github.com/markojerkic/svarog/internal/server/ui/components/field"
import selectcomp "github.com/markojerkic/svarog/internal/server/ui/components/select"
import "github.com/markojerkic/svarog/internal/server/ui/components/datepicker"
import "github.com/markojerkic/svarog/internal/server/types"
import "github.com/markojerkic/svarog/internal/server/ui/components/erroralert"
import "github.com/markojerkic/svarog/internal/lib/projects"

type ConnectionStringFormProps struct {
	ProjectID string
	Clients   []projects.Client
	ApiError  types.ApiError
}

templ ConnectionStringForm(props ...ConnectionStringFormProps) {
	{{ var p ConnectionStringFormProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<form
		class="space-y-4"
		id="connection-string-form"
		hx-post="/admin/projects/conn-string"
		hx-swap="none"
		hx-disabled-elt="input, button"
	>
		<input type="hidden" name="projectId" value={ p.ProjectID }/>
		<div class="space-y-2">
			@field.Field(field.Props{Class: "space-y-2"}) {
				@field.Label(field.LabelProps{For: "clientId"}) {
					Client
				}
				{{
					clientItems := make([]selectcomp.ItemData, len(p.Clients))
					for i, client := range p.Clients {
						clientItems[i] = selectcomp.ItemData{Value: client.ID.String(), Label: client.Name}
					}
				}}
				@selectcomp.Select(selectcomp.Props{
					Name:  "clientId",
					Items: clientItems,
				}) {
					@selectcomp.Trigger(selectcomp.TriggerProps{
						ID:    "clientId",
						Class: "w-full",
						Attributes: templ.Attributes{
							"required":     "",
							"aria-invalid": p.ApiError.Fields["clientId"] != "",
						},
					}) {
						@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Select a client"})
					}
					@selectcomp.Content() {
						for _, client := range p.Clients {
							@selectcomp.Item(selectcomp.ItemProps{Value: client.ID.String()}) {
								{ client.Name }
							}
						}
					}
				}
				if p.ApiError.Fields["clientId"] != "" {
					@field.Error() {
						{ p.ApiError.Fields["clientId"] }
					}
				} else {
					@field.Description() {
						Select the client for which to generate credentials
					}
				}
			}
		</div>
		<div class="space-y-2">
			@field.Field(field.Props{Class: "space-y-2"}) {
				@field.Label(field.LabelProps{For: "expiry"}) {
					Expiry Date (Optional)
				}
				@datepicker.DatePicker(datepicker.Props{
					ID:          "expiry",
					Name:        "expiry",
					Placeholder: "Select expiry date",
					HasError:    p.ApiError.Fields["expiry"] != "",
				})
				if p.ApiError.Fields["expiry"] != "" {
					@field.Error() {
						{ p.ApiError.Fields["expiry"] }
					}
				} else {
					@field.Description() {
						Leave empty for credentials that never expire
					}
				}
			}
		</div>
		@erroralert.ErrorAlert(erroralert.Props{Message: p.ApiError.Message})
	</form>
}

templ ConnectionStringDialog() {
	@dialog.Dialog(dialog.Props{ID: "connection-string-dialog"}) {
		{ children... }
		@dialog.Content(dialog.ContentProps{Class: "max-w-md"}) {
			@dialog.Header() {
				@dialog.Title() {
					Generate Connection String
				}
				@dialog.Description() {
					Generate credentials for a specific client
				}
			}
			<div id="connection-string-form-container">
				@ConnectionStringForm()
			</div>
			@dialog.Footer() {
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Attributes: dialog.Close(ctx),
				}) {
					Cancel
				}
				@button.Button(button.Props{
					Type: button.TypeSubmit,
					Attributes: templ.Attributes{
						"form": "connection-string-form",
					},
				}) {
					Generate
				}
			}
		}
	}
}
