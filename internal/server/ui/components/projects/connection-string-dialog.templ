package projectcomponents

import "github.com/markojerkic/svarog/internal/server/ui/components/dialog"
import "github.com/markojerkic/svarog/internal/server/ui/components/button"
import "github.com/markojerkic/svarog/internal/server/ui/components/field"
import selectcomp "github.com/markojerkic/svarog/internal/server/ui/components/select"
import "github.com/markojerkic/svarog/internal/server/ui/components/datepicker"
import "github.com/markojerkic/svarog/internal/server/types"
import "github.com/markojerkic/svarog/internal/server/ui/components/erroralert"
import "github.com/markojerkic/svarog/internal/server/ui/components/textarea"
import "github.com/markojerkic/svarog/internal/lib/projects"
import "time"
import "github.com/markojerkic/svarog/internal/server/i18n"

type ConnectionStringFormProps struct {
	ProjectID string
	Clients   []projects.Client
	ApiError  types.ApiError
}

templ ConnectionStringForm(props ...ConnectionStringFormProps) {
	{{ var p ConnectionStringFormProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<form
		class="space-y-4"
		id="connection-string-form"
		hx-post="/admin/projects/conn-string"
		hx-target="#connection-string-form-container"
		hx-swap="innerHTML"
		hx-disable="input, button"
	>
		<input type="hidden" name="projectId" value={ p.ProjectID }/>
		<div class="space-y-2">
			@field.Field(field.Props{Class: "space-y-2"}) {
				@field.Label(field.LabelProps{For: "clientId"}) {
					{ i18n.T(ctx, "connection.client") }
				}
				{{
					clientItems := make([]selectcomp.ItemData, len(p.Clients))
					for i, client := range p.Clients {
						clientItems[i] = selectcomp.ItemData{Value: client.ID.String(), Label: client.Name}
					}
				}}
				@selectcomp.Select(selectcomp.Props{
					Name:  "clientId",
					Items: clientItems,
				}) {
					@selectcomp.Trigger(selectcomp.TriggerProps{
						ID:    "clientId",
						Class: "w-full",
						Attributes: templ.Attributes{
							"required":     "",
							"aria-invalid": p.ApiError.Fields["clientId"] != "",
						},
					}) {
						@selectcomp.Value(selectcomp.ValueProps{Placeholder: i18n.T(ctx, "connection.select_client")})
					}
					@selectcomp.Content() {
						for _, client := range p.Clients {
							@selectcomp.Item(selectcomp.ItemProps{Value: client.ID.String()}) {
								{ client.Name }
							}
						}
					}
				}
				if p.ApiError.Fields["clientId"] != "" {
					@field.Error() {
						{ p.ApiError.Fields["clientId"] }
					}
				} else {
					@field.Description() {
						{ i18n.T(ctx, "connection.client_description") }
					}
				}
			}
		</div>
		<div class="space-y-2">
			@field.Field(field.Props{Class: "space-y-2"}) {
				@field.Label(field.LabelProps{For: "expiry"}) {
					{ i18n.T(ctx, "connection.expiry") }
				}
				{{
					now := time.Now().UTC()
					startOfToday := time.Date(now.Year(), now.Month(), now.Day(), 0, 0, 0, 0, time.UTC)
				}}
				@datepicker.DatePicker(datepicker.Props{
					ID:          "expiry",
					Name:        "expiry",
					Placeholder: i18n.T(ctx, "connection.expiry_placeholder"),
					HasError:    p.ApiError.Fields["expiry"] != "",
					NotBefore:   startOfToday,
				})
				if p.ApiError.Fields["expiry"] != "" {
					@field.Error() {
						{ p.ApiError.Fields["expiry"] }
					}
				} else {
					@field.Description() {
						{ i18n.T(ctx, "connection.expiry_description") }
					}
				}
			}
		</div>
		@erroralert.ErrorAlert(erroralert.Props{Message: p.ApiError.Message})
	</form>
}

templ ConnectionStringDialog() {
	@dialog.Dialog(dialog.Props{ID: "connection-string-dialog"}) {
		{ children... }
		@dialog.Content(dialog.ContentProps{Class: "max-h-[calc(100dvh-2rem)] overflow-y-auto sm:max-w-lg"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "connection.generate_title") }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "connection.description") }
				}
			}
			<div id="connection-string-form-container">
				@ConnectionStringForm()
			</div>
			@connectionStringFooter(false, false)
		}
	}
}

templ ConnectionStringFormResponse(props ...ConnectionStringFormProps) {
	@ConnectionStringForm(props...)
	@connectionStringFooter(false, true)
}

templ ConnectionStringResult(connString string) {
	<div class="space-y-2">
		@field.Field(field.Props{Class: "space-y-2"}) {
			@field.Label(field.LabelProps{For: "connection-string-value"}) {
				{ i18n.T(ctx, "connection.title") }
			}
			@textarea.Textarea(textarea.Props{
				ID:       "connection-string-value",
				ReadOnly: true,
				Rows:     6,
				Value:    connString,
				Class:    "max-h-64 min-h-24 overflow-auto break-all font-mono text-xs",
				Attributes: templ.Attributes{
					"data-copy-source": "true",
					"spellcheck":       "false",
					"style":            "field-sizing: fixed; overflow-wrap: anywhere;",
				},
			})
		}
	</div>
	@connectionStringFooter(true, true)
}

templ connectionStringFooter(copy bool, oob bool) {
	{{
		attrs := templ.Attributes{}
		if oob {
			attrs["hx-swap-oob"] = "outerHTML"
		}
	}}
	@dialog.Footer(dialog.FooterProps{
		ID:         "connection-string-dialog-footer",
		Attributes: attrs,
	}) {
		if copy {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Attributes: dialog.CloseFor("connection-string-dialog"),
			}) {
				{ i18n.T(ctx, "common.close") }
			}
			@button.Button(button.Props{
				Attributes: templ.Attributes{
					"data-copy-target": "connection-string-value",
				},
			}) {
				{ i18n.T(ctx, "common.copy") }
			}
		} else {
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Attributes: dialog.CloseFor("connection-string-dialog"),
			}) {
				{ i18n.T(ctx, "common.cancel") }
			}
			@button.Button(button.Props{
				Type: button.TypeSubmit,
				Attributes: templ.Attributes{
					"form": "connection-string-form",
				},
			}) {
				{ i18n.T(ctx, "common.generate") }
			}
		}
	}
}
