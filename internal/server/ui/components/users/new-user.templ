package usercomponents

import "github.com/markojerkic/svarog/internal/server/ui/components/dialog"
import "github.com/markojerkic/svarog/internal/server/ui/components/button"
import "github.com/markojerkic/svarog/internal/server/ui/components/field"
import "github.com/markojerkic/svarog/internal/server/ui/components/input"
import selectcomp "github.com/markojerkic/svarog/internal/server/ui/components/select"
import "github.com/markojerkic/svarog/internal/server/types"
import "github.com/markojerkic/svarog/internal/server/ui/components/erroralert"
import "github.com/markojerkic/svarog/internal/server/ui/components/icon"
import "github.com/markojerkic/svarog/internal/lib/auth"
import "github.com/markojerkic/svarog/internal/server/ui/components/combobox"
import "github.com/markojerkic/svarog/internal/server/i18n"

type NewUserFormProps struct {
	FormID   string
	ApiError types.ApiError
	Value    types.CreateUserForm
}

templ NewUserForm(props ...NewUserFormProps) {
	{{ var p NewUserFormProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{
		if p.FormID == "" {
			p.FormID = "new-user-form"
			if p.Value.ID != "" {
				p.FormID = "edit-user-form"
			}
		}
	}}
	<form
		class="space-y-4"
		id={ p.FormID }
		hx-post="/admin/users"
		hx-swap="outerHTML"
		hx-select="body"
		hx-target="body"
		hx-disable="input, button, button[form='new-user-form'], button[form='edit-user-form']"
	>
		<input type="hidden" name="id" value={ p.Value.ID }/>
		<div class="space-y-2">
			@field.Field(field.Props{
				Class: "space-y-2",
			}) {
				@field.Label(field.LabelProps{For: p.FormID + "-username"}) {
					{ i18n.T(ctx, "auth.username") }
				}
				@input.Input(input.Props{
					ID:          p.FormID + "-username",
					Name:        "username",
					Placeholder: i18n.T(ctx, "auth.username_placeholder"),
					ReadOnly:    p.Value.ID != "",
					Value:       p.Value.Username,
					Attributes: templ.Attributes{
						"required":     "",
						"maxlength":    types.UsernameMaxLength,
						"aria-invalid": p.ApiError.Fields["username"] != "",
					},
				})
				if p.ApiError.Fields["username"] != "" {
					@field.Error() {
						{ p.ApiError.Fields["username"] }
					}
				}
			}
		</div>
		<div class="space-y-2">
			@field.Field(field.Props{
				Class: "space-y-2",
			}) {
				@field.Label(field.LabelProps{For: p.FormID + "-firstName"}) {
					{ i18n.T(ctx, "users.first_name") }
				}
				@input.Input(input.Props{
					Name:        "firstName",
					ID:          p.FormID + "-firstName",
					Placeholder: i18n.T(ctx, "users.first_name_placeholder"),
					Value:       p.Value.FirstName,
					Attributes: templ.Attributes{
						"required":     "",
						"maxlength":    types.UserProfileNameMaxLength,
						"aria-invalid": p.ApiError.Fields["firstName"] != "",
					},
				})
				if p.ApiError.Fields["firstName"] != "" {
					@field.Error() {
						{ p.ApiError.Fields["firstName"] }
					}
				}
			}
		</div>
		<div class="space-y-2">
			@field.Field(field.Props{
				Class: "space-y-2",
			}) {
				@field.Label(field.LabelProps{For: p.FormID + "-lastName"}) {
					{ i18n.T(ctx, "users.last_name") }
				}
				@input.Input(input.Props{
					Name:        "lastName",
					ID:          p.FormID + "-lastName",
					Placeholder: i18n.T(ctx, "users.last_name_placeholder"),
					Value:       p.Value.LastName,
					Attributes: templ.Attributes{
						"required":     "",
						"maxlength":    types.UserProfileNameMaxLength,
						"aria-invalid": p.ApiError.Fields["lastName"] != "",
					},
				})
				if p.ApiError.Fields["lastName"] != "" {
					@field.Error() {
						{ p.ApiError.Fields["lastName"] }
					}
				}
			}
		</div>
		<div class="space-y-2">
			@field.Field(field.Props{
				Class: "space-y-2",
			}) {
				@field.Label(field.LabelProps{For: p.FormID + "-role"}) {
					{ i18n.T(ctx, "users.role") }
				}
				@selectcomp.Select(selectcomp.Props{
					Name:         "role",
					DefaultValue: p.Value.Role,
					Items: []selectcomp.ItemData{
						{Value: string(auth.USER), Label: i18n.T(ctx, "users.role_user")},
						{Value: string(auth.ADMIN), Label: i18n.T(ctx, "users.role_admin")},
					},
				}) {
					@selectcomp.Trigger(selectcomp.TriggerProps{ID: p.FormID + "-role", Class: "w-full"}) {
						@selectcomp.Value(selectcomp.ValueProps{Placeholder: i18n.T(ctx, "users.select_role")})
					}
					@selectcomp.Content() {
						@selectcomp.Item(selectcomp.ItemProps{Value: string(auth.USER)}) {
							{ i18n.T(ctx, "users.role_user") }
						}
						@selectcomp.Item(selectcomp.ItemProps{Value: string(auth.ADMIN)}) {
							{ i18n.T(ctx, "users.role_admin") }
						}
					}
				}
				if p.ApiError.Fields["role"] != "" {
					@field.Error() {
						{ p.ApiError.Fields["role"] }
					}
				}
			}
		</div>
		@field.Field(field.Props{
			Class: "space-y-2",
		}) {
			@field.Label(field.LabelProps{For: p.FormID + "-projects-search"}) {
				{ i18n.T(ctx, "nav.projects") }
			}
			@combobox.ComboBox(combobox.SearchProps{
				ID:          p.FormID + "-projects",
				Name:        "projects",
				Form:        p.FormID,
				SearchURL:   "/admin/projects/search",
				Values:      p.Value.Projects,
				Placeholder: i18n.T(ctx, "projects.search"),
				HasError:    p.ApiError.Fields["projects"] != "",
				Multiple:    true,
			})
			if p.ApiError.Fields["projects"] != "" {
				@field.Error() {
					{ p.ApiError.Fields["projects"] }
				}
			}
		}
		@erroralert.ErrorAlert(erroralert.Props{Message: p.ApiError.Message})
	</form>
}

templ NewUser() {
	@dialog.Dialog(dialog.Props{
		ID: "new-user-dialog",
	}) {
		@button.Button(button.Props{
			Variant:    button.VariantDefault,
			Attributes: dialog.Trigger(ctx),
		}) {
			<span class="flex items-center">
				@icon.Plus(icon.Props{Size: 16, Class: "mr-2"})
				{ i18n.T(ctx, "users.new") }
			</span>
		}
		@dialog.Content(dialog.ContentProps{
			Class: "max-w-md max-h-[calc(100dvh-2rem)] overflow-y-auto",
		}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "users.create_title") }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "users.create_description") }
				}
			}
			@NewUserForm()
			@dialog.Footer() {
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Attributes: dialog.Close(ctx),
				}) {
					{ i18n.T(ctx, "common.cancel") }
				}
				@button.Button(button.Props{
					Type: button.TypeSubmit,
					Attributes: templ.Attributes{
						"form": "new-user-form",
					},
				}) {
					{ i18n.T(ctx, "common.save") }
				}
			}
		}
	}
}
