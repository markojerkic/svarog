package archives

import "strconv"
import "github.com/markojerkic/svarog/internal/lib/archive"
import "github.com/markojerkic/svarog/internal/server/i18n"
import "github.com/markojerkic/svarog/internal/server/ui/components/button"
import "github.com/markojerkic/svarog/internal/server/ui/components/icon"
import "github.com/markojerkic/svarog/internal/server/ui/components/input"
import "github.com/markojerkic/svarog/internal/server/ui/components/label"
import "github.com/markojerkic/svarog/internal/server/ui/components/sheet"
import "github.com/markojerkic/svarog/internal/server/ui/shadcnutil"

templ Trigger(projectID, clientID string) {
	@button.Button(button.Props{
		ID:      "log-archive-trigger",
		Variant: button.VariantOutline,
		Size:    button.SizeSm,
		Attributes: utils.MergeAttributes(sheet.TriggerFor("log-archive-sheet"), templ.Attributes{
			"hx-get":     ArchivePanelURL(projectID, clientID),
			"hx-target":  "#log-archive-panel",
			"hx-swap":    "innerHTML",
			"hx-trigger": "click",
			"aria-label": i18n.T(ctx, "archives.title"),
			"title":      i18n.T(ctx, "archives.title"),
		}),
	}) {
		@icon.Archive(icon.Props{Class: "size-3.5"})
		<span class="hidden lg:inline">{ i18n.T(ctx, "archives.title") }</span>
	}
}

templ SettingsSheet() {
	@sheet.Sheet(sheet.Props{ID: "log-archive-sheet"}) {
		@sheet.Content(sheet.ContentProps{
			Class: "gap-0 data-[side=right]:w-full data-[side=right]:sm:max-w-sm",
		}) {
			@sheet.Header(sheet.HeaderProps{Class: "shrink-0 gap-2 p-6 pr-12"}) {
				@sheet.Title() {
					{ i18n.T(ctx, "archives.title") }
				}
			}
			<div id="log-archive-panel" class="flex min-h-0 flex-1 flex-col"></div>
		}
	}
}

type SettingsFormProps struct {
	ProjectID string
	ClientID  string
	Policy    archive.Policy
}

templ ViewSwitch(projectID, clientID, active string) {
	<div role="tablist" aria-label={ i18n.T(ctx, "archives.tabs") } class="grid shrink-0 grid-cols-2 gap-1 rounded-lg bg-muted p-1">
		@archiveViewTab(projectID, clientID, "archives", active)
		@archiveViewTab(projectID, clientID, "settings", active)
	</div>
}

templ archiveViewTab(projectID, clientID, name, active string) {
	{{ selected := name == active }}
	<button
		type="button"
		role="tab"
		aria-selected={ strconv.FormatBool(selected) }
		class={ "rounded-md px-2 py-1 text-sm font-medium", templ.KV("bg-background text-foreground shadow-sm", selected), templ.KV("text-muted-foreground", !selected) }
		if !selected {
			hx-get={ archiveViewURL(projectID, clientID, name) }
			hx-target="#log-archive-view"
			hx-swap="outerHTML"
			hx-sync="#log-archive-sheet:drop"
			hx-push-url="false"
			hx-boost="false"
			hx-disable="#log-archive-view button, #log-archive-view input"
		}
	>
		if name == "settings" {
			{ i18n.T(ctx, "archives.settings") }
		} else {
			{ i18n.T(ctx, "archives.show_archives") }
		}
	</button>
}

func archiveViewURL(projectID, clientID, name string) string {
	if name == "settings" {
		return ArchiveSettingsURL(projectID, clientID)
	}
	return ArchivePanelURL(projectID, clientID)
}

templ Rule(props SettingsFormProps) {
	<div class="space-y-0.5">
		<p class="text-sm font-medium">
			if props.Policy.Enabled {
				{ formatRuleAge(ctx, props.Policy.ArchiveAfterWeeks) }
			} else {
				{ i18n.T(ctx, "archives.rule_off") }
			}
		</p>
		<p class="text-xs text-muted-foreground">
			if props.Policy.Enabled {
				{ i18n.T(ctx, "archives.rule_on") }
			} else {
				{ i18n.T(ctx, "archives.rule_off_hint") }
			}
		</p>
	</div>
}

templ SettingsEditor(props SettingsFormProps) {
	<div id="log-archive-view" class="flex min-h-0 flex-1 flex-col gap-4 overflow-y-auto px-6 pt-1 pb-6">
		@ViewSwitch(props.ProjectID, props.ClientID, "settings")
		@SettingsForm(props)
	</div>
}

templ SettingsForm(props SettingsFormProps) {
	{{ weeks := props.Policy.ArchiveAfterWeeks }}
	if weeks < 1 {
		{{ weeks = 4 }}
	}
	<form
		id="log-archive-settings-form"
		hx-post={ ArchiveSettingsURL(props.ProjectID, props.ClientID) }
		hx-disable="#log-archive-view button, #log-archive-view input"
		hx-sync="#log-archive-sheet:drop"
		hx-target="#log-archive-view"
		hx-swap="outerHTML"
		hx-push-url="false"
		hx-boost="false"
		class="space-y-3"
	>
		<div class="flex items-center justify-between gap-4">
			@label.Label(label.Props{For: "archive-enabled"}) {
				{ i18n.T(ctx, "archives.on") }
			}
			<label class="relative inline-flex shrink-0 cursor-pointer items-center">
				<input
					id="archive-enabled"
					name="enabled"
					type="checkbox"
					value="true"
					role="switch"
					checked?={ props.Policy.Enabled }
					class="peer sr-only"
				/>
				<span aria-hidden="true" class="inline-flex h-5 w-8 items-center rounded-full border border-transparent bg-input p-0.5 transition-colors peer-checked:bg-primary peer-checked:[&>span]:translate-x-3 peer-checked:[&>span]:bg-primary-foreground peer-focus-visible:ring-3 peer-focus-visible:ring-ring/50 motion-reduce:transition-none">
					<span class="size-3.5 rounded-full bg-background shadow-xs transition-transform motion-reduce:transition-none"></span>
				</span>
			</label>
		</div>
		<div class="flex flex-wrap items-center gap-2.5">
			<label class="sr-only" for="archive-after-weeks">{ i18n.T(ctx, "archives.older_than") }</label>
			@input.Input(input.Props{
				ID:       "archive-after-weeks",
				Name:     "archiveAfterWeeks",
				Type:     "number",
				Value:    strconv.Itoa(weeks),
				Class:    "w-22 tabular-nums",
				Disabled: !props.Policy.Enabled,
				Required: true,
				Attributes: templ.Attributes{
					"min":              "1",
					"max":              strconv.Itoa(archive.MaxArchiveAfterWeeks),
					"step":             "1",
					"inputmode":        "numeric",
					"aria-describedby": "archive-weeks-unit archive-weeks-error",
				},
			})
			<span id="archive-weeks-unit" class="text-sm text-muted-foreground">{ i18n.T(ctx, "archives.weeks") }</span>
			@button.Button(button.Props{
				ID:   "archive-save-changes",
				Type: button.TypeSubmit,
				Size: button.SizeSm,
			}) {
				{ i18n.T(ctx, "common.save") }
			}
		</div>
		<p id="archive-weeks-error" class="text-xs text-destructive" role="status" hidden>{ i18n.T(ctx, "archives.invalid_weeks") }</p>
	</form>
}

templ RunControl(props SettingsFormProps) {
	<div id="log-archive-run" class="space-y-2">
		@button.Button(button.Props{
			ID:       "archive-run",
			Size:     button.SizeSm,
			Class:    "w-full",
			Disabled: !props.Policy.Enabled,
			Attributes: templ.Attributes{
				"hx-post":          ArchivePanelURL(props.ProjectID, props.ClientID) + "/create",
				"hx-target":        "#log-archive-list",
				"hx-swap":          "outerHTML",
				"hx-sync":          "#log-archive-sheet:drop",
				"hx-disable":       "#log-archive-view button, #log-archive-view input",
				"hx-indicator":     "this",
				"aria-describedby": "archive-run-description",
			},
		}) {
			<span class="svarog-indicator-container" aria-hidden="true">
				<span data-fallback>@icon.Archive(icon.Props{Class: "size-3.5"})</span>
				<span>@icon.LoaderCircle(icon.Props{Class: "size-3.5 animate-spin motion-reduce:animate-none"})</span>
			</span>
			<span class="svarog-indicator" data-fallback>{ i18n.T(ctx, "archives.run") }</span>
			<span class="svarog-indicator" role="status">{ i18n.T(ctx, "archives.running") }</span>
		}
		<p id="archive-run-description" class="text-xs text-muted-foreground">{ i18n.T(ctx, "archives.run_description") }</p>
		if !props.Policy.Enabled {
			<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "archives.enable_first") }</p>
		}
	</div>
}
