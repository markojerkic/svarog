package logs

import "github.com/markojerkic/svarog/internal/server/ui/components/button"
import "github.com/markojerkic/svarog/internal/server/ui/components/dialog"
import "github.com/markojerkic/svarog/internal/server/ui/components/icon"
import "github.com/markojerkic/svarog/internal/server/ui/components/input"
import "github.com/markojerkic/svarog/internal/server/ui/shadcnutil"

templ SearchTrigger(search string) {
	@button.Button(button.Props{
		ID:      "log-search-trigger",
		Variant: button.VariantSecondary,
		Size:    button.SizeSm,
		Class:   "max-w-24 gap-2 sm:max-w-72",
		Attributes: utils.MergeAttributes(dialog.TriggerFor("log-search-dialog"), templ.Attributes{
			"aria-label":        "Search logs",
			"aria-keyshortcuts": "Control+k Meta+k",
		}),
	}) {
		@icon.Search(icon.Props{Class: "size-3.5"})
		if search != "" {
			<span class="truncate">{ search }</span>
		} else {
			<span>Search</span>
			<kbd class="hidden rounded border bg-background px-1 py-0.5 text-[10px] font-normal text-muted-foreground sm:inline-block">Ctrl K</kbd>
		}
	}
}

templ SearchDialog(action, search string, instances *[]string) {
	@dialog.Dialog(dialog.Props{ID: "log-search-dialog"}) {
		@dialog.Content(dialog.ContentProps{
			Class:           "top-[18svh] -translate-y-0 gap-0 p-0 shadow-xl sm:max-w-[650px]",
			HideCloseButton: true,
		}) {
			@dialog.Title(dialog.TitleProps{Class: "sr-only"}) {
				Search logs
			}
			<form
				id="log-search-form"
				method="get"
				action={ templ.SafeURL(action) }
				hx-boost="true"
				hx-target="body"
				hx-swap="innerHTML"
				hx-push-url="true"
				hx-sync="body:replace"
				hx-disable="find button[type='submit']"
				class="flex items-center gap-4 px-4 sm:px-5"
			>
				if instances != nil {
					for _, instance := range *instances {
						<input type="hidden" name="instance" value={ instance }/>
					}
				}
				@icon.Search(icon.Props{Class: "size-5 shrink-0 text-muted-foreground"})
				@input.Input(input.Props{
					ID:          "log-search-input",
					Name:        "search",
					Type:        "search",
					Value:       search,
					Required:    true,
					Placeholder: "Search logs…",
					Class:       "h-16 flex-1 rounded-none border-0 bg-transparent px-0 py-0 text-base shadow-none focus-visible:ring-0 md:text-base dark:bg-transparent",
					Attributes: templ.Attributes{
						"aria-label":   "Search logs",
						"autocomplete": "off",
						"spellcheck":   "false",
						"enterkeyhint": "search",
					},
				})
				@button.Button(button.Props{
					Variant: button.VariantSecondary,
					Size:    button.SizeIconSm,
					Type:    button.TypeSubmit,
					Attributes: templ.Attributes{
						"aria-label": "Run search",
					},
				}) {
					@icon.CornerDownLeft(icon.Props{Class: "size-3.5"})
				}
			</form>
		}
	}
}
