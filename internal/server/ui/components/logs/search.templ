package logs

import "github.com/markojerkic/svarog/internal/server/ui/components/button"
import "github.com/markojerkic/svarog/internal/server/ui/components/dialog"
import "github.com/markojerkic/svarog/internal/server/ui/components/icon"
import "github.com/markojerkic/svarog/internal/server/ui/components/input"
import "github.com/markojerkic/svarog/internal/server/ui/components/tooltip"
import "github.com/markojerkic/svarog/internal/server/ui/shadcnutil"
import "github.com/markojerkic/svarog/internal/server/i18n"

templ SearchTrigger(search string) {
	@tooltip.Tooltip(tooltip.Props{ID: "log-search-query-tooltip"}) {
		{{
			attributes := utils.MergeAttributes(dialog.TriggerFor("log-search-dialog"), templ.Attributes{
				"aria-label":        i18n.T(ctx, "logs.search"),
				"aria-keyshortcuts": "Control+k Meta+k",
			})
		}}
		if search != "" {
			{{ attributes = utils.MergeAttributes(tooltip.Trigger(ctx), attributes, templ.Attributes{"aria-describedby": "log-search-query-tooltip"}) }}
		}
		@button.Button(button.Props{
			ID:         "log-search-trigger",
			Variant:    button.VariantSecondary,
			Size:       button.SizeSm,
			Class:      "max-w-24 gap-2 sm:max-w-40 xl:max-w-72",
			Attributes: attributes,
		}) {
			@icon.Search(icon.Props{Class: "size-3.5"})
			if search != "" {
				<span class="truncate">{ search }</span>
			} else {
				<span>{ i18n.T(ctx, "common.search") }</span>
				<kbd class="hidden rounded border bg-background px-1 py-0.5 text-[10px] font-normal text-muted-foreground sm:inline-block">Ctrl K</kbd>
			}
		}
		if search != "" {
			@tooltip.Content(tooltip.ContentProps{
				Side:       tooltip.SideBottom,
				Class:      "whitespace-normal wrap-anywhere",
				Attributes: templ.Attributes{"role": "tooltip"},
			}) {
				{ search }
			}
		}
	}
}

templ SearchDialog(action, search string, instances *[]string) {
	@dialog.Dialog(dialog.Props{ID: "log-search-dialog"}) {
		@dialog.Content(dialog.ContentProps{
			Class:           "top-[18svh] -translate-y-0 gap-0 p-0 shadow-xl sm:max-w-[650px]",
			HideCloseButton: true,
		}) {
			@dialog.Title(dialog.TitleProps{Class: "sr-only"}) {
				{ i18n.T(ctx, "logs.search") }
			}
			<form
				id="log-search-form"
				method="get"
				action={ templ.SafeURL(action) }
				hx-boost="true"
				hx-target="body"
				hx-swap="innerHTML"
				hx-push-url="true"
				hx-sync="body:replace"
				hx-disable="find #log-search-input, find button[type='submit']"
				hx-indicator:append="this"
				class="flex items-center gap-4 px-4 sm:px-5"
			>
				if instances != nil {
					for _, instance := range *instances {
						<input type="hidden" name="instance" value={ instance }/>
					}
				}
				@icon.Search(icon.Props{Class: "size-5 shrink-0 text-muted-foreground"})
				<div class="relative min-w-0 flex-1">
					@input.Input(input.Props{
						ID:          "log-search-input",
						Name:        "search",
						Type:        "search",
						Value:       search,
						Placeholder: i18n.T(ctx, "logs.search_placeholder"),
						Class:       "h-16 rounded-none border-0 bg-transparent px-0 py-0 text-base shadow-none focus-visible:ring-0 disabled:bg-transparent disabled:opacity-100 md:text-base dark:bg-transparent dark:disabled:bg-transparent",
						Attributes: templ.Attributes{
							"aria-label":   i18n.T(ctx, "logs.search"),
							"autocomplete": "off",
							"spellcheck":   "false",
							"enterkeyhint": "search",
						},
					})
					<span class="htmx-indicator pointer-events-none absolute inset-y-0 right-0 flex items-center text-muted-foreground" role="status">
						<span class="sr-only">{ i18n.T(ctx, "logs.searching") }</span>
						@icon.LoaderCircle(icon.Props{Class: "size-4 animate-spin motion-reduce:animate-none", Attributes: templ.Attributes{"aria-hidden": "true"}})
					</span>
				</div>
				@button.Button(button.Props{
					Variant: button.VariantSecondary,
					Size:    button.SizeIconSm,
					Type:    button.TypeSubmit,
					Attributes: templ.Attributes{
						"aria-label": i18n.T(ctx, "logs.run_search"),
					},
				}) {
					@icon.CornerDownLeft(icon.Props{Class: "size-3.5"})
				}
			</form>
		}
	}
}
