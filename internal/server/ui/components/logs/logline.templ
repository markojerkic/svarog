package logs

import "strconv"
import "time"
import "github.com/markojerkic/svarog/internal/server/logstore"
import "github.com/markojerkic/svarog/internal/server/ui/components/button"
import "github.com/markojerkic/svarog/internal/server/ui/components/icon"
import "github.com/markojerkic/svarog/internal/lib/logsearch"
import "github.com/markojerkic/svarog/internal/server/i18n"

type LogLineProps struct {
	Row       logstore.Row
	Search    logsearch.Query
	IsContext bool
}

templ LogLineText(text string, search logsearch.Query) {
	for _, part := range logsearch.Highlight(text, search.Terms) {
		if part.Matched {
			<mark class="rounded-xs bg-amber-200 text-amber-950 dark:bg-amber-400/30 dark:text-amber-100">{ part.Text }</mark>
		} else {
			{ part.Text }
		}
	}
}

templ LogLine(props LogLineProps) {
	@RecordLine(props.Row.OccurredAt, props.Row.Instance, props.Row.Message, props.Search, props.IsContext, templ.Attributes{
		"data-sequence": strconv.FormatInt(props.Row.Sequence, 10),
		"data-log-id":   strconv.FormatInt(props.Row.ID, 10),
	}) {
		@button.Button(button.Props{
			Variant: button.VariantGhost,
			Size:    button.SizeIconXs,
			Class:   RowActionClass,
			Attributes: templ.Attributes{
				"aria-labelledby":       "log-line-actions-label",
				"data-log-menu-trigger": "true",
				"data-log-id":           strconv.FormatInt(props.Row.ID, 10),
				"data-log-content":      props.Row.Message,
				"data-instance-id":      props.Row.Instance,
			},
		}) {
			@icon.EllipsisVertical()
		}
	}
}

const RowActionClass = "sticky right-0 ml-3 bg-card opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 focus-visible:opacity-100 pointer-coarse:opacity-100"

templ RecordLine(at time.Time, instance, message string, search logsearch.Query, anchor bool, attrs templ.Attributes) {
	<pre
		class="group flex min-w-full w-max items-center border-l-4 pl-3 text-foreground hover:bg-muted/50"
		data-timestamp={ at.UnixNano() }
		data-instance-id={ instance }
		{ attrs... }
		if anchor {
			data-log-anchor="true"
			aria-current="true"
		}
	>
		<div data-log-meta class="contents">
			<time
				data-log-time
				class="mr-3 shrink-0 text-muted-foreground tabular-nums"
				datetime={ at.UTC().Format(time.RFC3339Nano) }
			></time>
			<span data-log-instance class="mr-3 max-w-36 shrink-0 truncate text-muted-foreground" title={ instance }>
				{ instance }
			</span>
		</div>
		<span data-log-message class="flex-1">
			@LogLineText(message, search)
		</span>
		{ children... }
	</pre>
}

// Fragments must come from LogLine rendering, never directly from log messages.
templ OobSwapLogLines(renderedRows []string) {
	<div hx-swap-oob="afterbegin:#log-scroll-container">
		for _, row := range renderedRows {
			@templ.Raw(row)
		}
	</div>
}

templ SharedLogMenu() {
	// Live rows are shared across languages; their label belongs to this page.
	<span id="log-line-actions-label" class="sr-only">{ i18n.T(ctx, "logs.line_actions") }</span>
	<div
		id="shared-log-menu"
		class="hidden fixed z-9999 w-48 p-1 bg-popover rounded-lg border text-popover-foreground text-sm shadow-lg"
		hx-target:inherited="body"
		hx-swap:inherited="innerHTML"
		hx-sync:inherited="body:replace"
	>
		<button
			type="button"
			class="w-full text-left flex items-center px-2 py-1.5 text-sm rounded-sm hover:bg-accent hover:text-accent-foreground cursor-default"
			onclick="logMenu.copyLogContent()"
		>
			@icon.Copy(icon.Props{Size: 16, Class: "mr-2"})
			{ i18n.T(ctx, "logs.copy_line") }
		</button>
		<button
			type="button"
			class="w-full text-left flex items-center px-2 py-1.5 text-sm rounded-sm hover:bg-accent hover:text-accent-foreground cursor-default"
			onclick="logMenu.copyLogLink()"
		>
			@icon.Link(icon.Props{Size: 16, Class: "mr-2"})
			{ i18n.T(ctx, "logs.copy_link") }
		</button>
		<a
			id="log-context-link"
			href=""
			data-log-context
			class="w-full text-left flex items-center px-2 py-1.5 text-sm rounded-sm hover:bg-accent hover:text-accent-foreground cursor-default"
		>
			@icon.ArrowUpRight(icon.Props{Size: 16, Class: "mr-2"})
			{ i18n.T(ctx, "logs.open_context") }
		</a>
		<a
			id="filter-instance-link"
			href=""
			data-log-instance-filter
			class="w-full text-left flex items-center px-2 py-1.5 text-sm rounded-sm hover:bg-accent hover:text-accent-foreground cursor-default"
		>
			@icon.Funnel(icon.Props{Size: 16, Class: "mr-2"})
			{ i18n.T(ctx, "logs.only_this_instance") }
		</a>
	</div>
}
