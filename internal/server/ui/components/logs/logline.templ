package logs

import "strconv"
import "github.com/markojerkic/svarog/internal/server/types"
import "github.com/markojerkic/svarog/internal/server/ui/components/button"
import "github.com/markojerkic/svarog/internal/server/ui/components/icon"
import "fmt"
import "github.com/markojerkic/svarog/internal/server/ui/utils"
import "regexp"
import "strings"
import "github.com/markojerkic/svarog/internal/server/i18n"

type LogLineProps struct {
	LogLine types.StoredLog
	Search  string
}

var searchWords = regexp.MustCompile(`[\p{L}\p{N}]+`)

templ LogLineText(text, search string) {
	{{
		terms := make(map[string]bool)
		for _, word := range searchWords.FindAllString(search, -1) {
			terms[strings.ToLower(word)] = true
		}
		cursor := 0
	}}
	if len(terms) > 0 {
		for _, match := range searchWords.FindAllStringIndex(text, -1) {
			if terms[strings.ToLower(text[match[0]:match[1]])] {
				{ text[cursor:match[0]] }<mark class="rounded-xs bg-amber-200 text-amber-950 dark:bg-amber-400/30 dark:text-amber-100">{ text[match[0]:match[1]] }</mark>
				{{ cursor = match[1] }}
			}
		}
	}
	{ text[cursor:] }
}

templ LogLine(props LogLineProps) {
	{{ borderColor := utils.StringToColor(props.LogLine.Client.InstanceId) }}
	<pre
		class="group flex min-w-full w-max items-center border-l-2 pl-3 text-foreground hover:bg-muted/50"
		style={ fmt.Sprintf("border-left-color: %s;", borderColor) }
		data-timestamp={ props.LogLine.Timestamp.UnixNano() }
		data-sequence={ props.LogLine.SequenceNumber }
		data-instance-id={ props.LogLine.Client.InstanceId }
	>
		<span class="flex-1">
			@LogLineText(props.LogLine.LogLine, props.Search)
		</span>
		@button.Button(button.Props{
			Variant: button.VariantGhost,
			Size:    button.SizeIconXs,
			Class:   "sticky right-0 ml-3 bg-card opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 focus-visible:opacity-100 pointer-coarse:opacity-100",
			Attributes: templ.Attributes{
				"aria-labelledby":       "log-line-actions-label",
				"data-log-menu-trigger": "true",
				"data-log-id":           strconv.FormatInt(props.LogLine.ID, 10),
				"data-log-content":      props.LogLine.LogLine,
				"data-instance-id":      props.LogLine.Client.InstanceId,
			},
		}) {
			@icon.EllipsisVertical()
		}
	</pre>
}

templ OobSwapLogLine(props LogLineProps) {
	<div hx-swap-oob="afterbegin:#log-scroll-container">
		@LogLine(props)
	</div>
}

templ SharedLogMenu() {
	// Live rows are shared across languages; their label belongs to this page.
	<span id="log-line-actions-label" class="sr-only">{ i18n.T(ctx, "logs.line_actions") }</span>
	<div
		id="shared-log-menu"
		class="hidden fixed z-9999 w-48 p-1 bg-popover rounded-lg border text-popover-foreground text-sm shadow-lg"
		hx-target:inherited="body"
		hx-swap:inherited="innerHTML"
		hx-sync:inherited="body:replace"
	>
		<button
			type="button"
			class="w-full text-left flex items-center px-2 py-1.5 text-sm rounded-sm hover:bg-accent hover:text-accent-foreground cursor-default"
			onclick="logMenu.copyLogContent()"
		>
			@icon.Copy(icon.Props{Size: 16, Class: "mr-2"})
			{ i18n.T(ctx, "logs.copy_line") }
		</button>
		<button
			type="button"
			class="w-full text-left flex items-center px-2 py-1.5 text-sm rounded-sm hover:bg-accent hover:text-accent-foreground cursor-default"
			onclick="logMenu.copyLogLink()"
		>
			@icon.Link(icon.Props{Size: 16, Class: "mr-2"})
			{ i18n.T(ctx, "logs.copy_link") }
		</button>
		<a
			id="log-context-link"
			href=""
			data-log-context
			class="w-full text-left flex items-center px-2 py-1.5 text-sm rounded-sm hover:bg-accent hover:text-accent-foreground cursor-default"
		>
			@icon.ArrowUpRight(icon.Props{Size: 16, Class: "mr-2"})
			{ i18n.T(ctx, "logs.open_context") }
		</a>
		<a
			id="filter-instance-link"
			href=""
			data-log-instance-filter
			class="w-full text-left flex items-center px-2 py-1.5 text-sm rounded-sm hover:bg-accent hover:text-accent-foreground cursor-default"
		>
			@icon.Funnel(icon.Props{Size: 16, Class: "mr-2"})
			{ i18n.T(ctx, "logs.only_this_instance") }
		</a>
	</div>
}
