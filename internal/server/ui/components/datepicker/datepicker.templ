package datepicker

import "time"
import "github.com/markojerkic/svarog/internal/server/ui/components/button"
import "github.com/markojerkic/svarog/internal/server/ui/components/calendar"
import "github.com/markojerkic/svarog/internal/server/ui/components/icon"
import "github.com/markojerkic/svarog/internal/server/ui/components/popover"
import "github.com/markojerkic/svarog/internal/server/ui/utils"
import "github.com/markojerkic/svarog/internal/server/i18n"

type Props struct {
	ID          string
	Name        string
	Placeholder string
	HasError    bool
	Attributes  templ.Attributes
	// NotBefore disables calendar days before this day. The zero value leaves every day selectable.
	NotBefore time.Time
}

templ DatePicker(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Placeholder == "" {
		{{ p.Placeholder = i18n.T(ctx, "common.select_date") }}
	}
	{{ popoverID := p.ID + "-popover" }}
	@popover.Popover(popover.Props{ID: popoverID}) {
		{{
			trigger := popover.Trigger(ctx)
			trigger["data-empty"] = "true"
			trigger["data-datepicker"] = p.ID
			trigger["data-placeholder"] = p.Placeholder
			if p.HasError {
				trigger["aria-invalid"] = "true"
			}
			for k, v := range p.Attributes {
				trigger[k] = v
			}
		}}
		@button.Button(button.Props{
			ID:         p.ID,
			Variant:    button.VariantOutline,
			Class:      utils.TwMerge("w-full justify-between font-normal data-[empty=true]:text-muted-foreground", utils.If(p.HasError, "border-destructive")),
			Attributes: trigger,
		}) {
			<span>{ p.Placeholder }</span>
			@icon.Calendar(icon.Props{Class: "size-4"})
		}
		@popover.Content(popover.ContentProps{Class: "w-auto p-0", Align: popover.AlignStart}) {
			{{
				calendarProps := calendar.Props{Mode: calendar.ModeSingle, Locale: i18n.Locale(ctx)}
				if !p.NotBefore.IsZero() {
					calendarProps.Disabled = calendar.DateBefore{Before: p.NotBefore}
					year, month, _ := p.NotBefore.Date()
					calendarProps.StartMonth = time.Date(year, month, 1, 0, 0, 0, 0, p.NotBefore.Location())
				}
			}}
			@calendar.Calendar(calendarProps)
		}
	}
	<input type="hidden" id={ p.ID + "-value" } name={ p.Name }/>
}
