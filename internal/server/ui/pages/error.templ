package pages

import "github.com/markojerkic/svarog/internal/server/ui/components/alert"
import "github.com/markojerkic/svarog/internal/server/ui/components/button"
import "github.com/markojerkic/svarog/internal/server/ui/components/icon"
import "strconv"
import "github.com/markojerkic/svarog/internal/server/ui/components"
import "context"
import "github.com/markojerkic/svarog/internal/server/i18n"

type ErrorPageProps struct {
	StatusCode int
	Title      string
	Message    string
}

func (p ErrorPageProps) GetTitle(ctx context.Context) string {
	if p.Title != "" {
		return p.Title
	}
	switch p.StatusCode {
	case 400, 401, 403, 404, 500, 502, 503:
		return i18n.T(ctx, "errors."+strconv.Itoa(p.StatusCode)+"_title")
	default:
		return i18n.T(ctx, "common.error")
	}
}

func (p ErrorPageProps) GetMessage(ctx context.Context) string {
	if p.Message != "" {
		return p.Message
	}
	switch p.StatusCode {
	case 400, 401, 403, 404, 500, 502, 503:
		return i18n.T(ctx, "errors."+strconv.Itoa(p.StatusCode)+"_message")
	default:
		return i18n.T(ctx, "errors.unexpected")
	}
}

templ ErrorPage(props ErrorPageProps) {
	@BaseLayout(BaseProps{Title: props.GetTitle(ctx)}) {
		<div class="fixed right-4 top-4 z-20">
			@components.LanguageSwitcher()
		</div>
		<div class="min-h-screen flex items-center justify-center p-4">
			<div class="max-w-md w-full space-y-6">
				<div class="text-center">
					<h1 class="text-6xl font-bold text-muted-foreground">{ strconv.Itoa(props.StatusCode) }</h1>
				</div>
				@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
					@icon.TriangleAlert(icon.Props{Class: "size-4"})
					@alert.Title() {
						{ props.GetTitle(ctx) }
					}
					@alert.Description() {
						{ props.GetMessage(ctx) }
					}
				}
				<div class="flex justify-center gap-4">
					@button.Button(button.Props{
						Variant: button.VariantOutline,
						Attributes: templ.Attributes{
							"onclick": "history.back()",
						},
					}) {
						@icon.ArrowLeft(icon.Props{Class: "size-4"})
						{ i18n.T(ctx, "common.back") }
					}
					@button.Button(button.Props{
						Href: "/",
					}) {
						@icon.House(icon.Props{Class: "size-4"})
						{ i18n.T(ctx, "common.home") }
					}
				</div>
			</div>
		</div>
	}
}
