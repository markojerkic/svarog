package auth

import "github.com/markojerkic/svarog/internal/server/ui/pages"
import "github.com/markojerkic/svarog/internal/server/ui/components/card"
import "github.com/markojerkic/svarog/internal/server/ui/components/field"
import "github.com/markojerkic/svarog/internal/server/ui/components/input"
import "github.com/markojerkic/svarog/internal/server/ui/components/button"
import "github.com/markojerkic/svarog/internal/server/ui/components"
import "github.com/markojerkic/svarog/internal/server/i18n"

type LoginPageProps struct {
	Error    string
	Username string
	Password string
	Redirect string
}

templ LoginPage(props ...LoginPageProps) {
	{{ var p LoginPageProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	@pages.BaseLayout(pages.BaseProps{Title: i18n.T(ctx, "auth.login_title")}) {
		<div class="flex min-h-svh flex-col items-center justify-center gap-6 overflow-auto bg-muted/40 p-6">
			<a href="/" class="flex items-center gap-2 text-sm font-semibold">
				<img src="/assets/logo.png" alt="" class="size-7"/>
				Svarog
			</a>
			@card.Card(card.Props{Class: "w-full max-w-sm [--card-spacing:--spacing(6)]"}) {
				@card.Header() {
					@card.Title() {
						<h1 class="text-xl font-semibold tracking-tight">{ i18n.T(ctx, "auth.welcome_back") }</h1>
					}
					@card.Description() {
						{ i18n.T(ctx, "auth.sign_in_description") }
					}
				}
				@card.Content() {
					<form
						hx-post="/login"
						hx-swap="innerHTML"
						hx-target="body"
						hx-disable="input, button"
						class="space-y-4"
					>
						if p.Redirect != "" {
							<input type="hidden" name="redirect" value={ p.Redirect }/>
						}
						@field.Field() {
							@field.Label(field.LabelProps{For: "username"}) {
								{ i18n.T(ctx, "auth.username") }
							}
							@input.Input(input.Props{
								ID:          "username",
								Name:        "username",
								Type:        "text",
								Value:       p.Username,
								Placeholder: i18n.T(ctx, "auth.username_placeholder"),
								Attributes: templ.Attributes{
									"required":     true,
									"autocomplete": "username",
									"aria-invalid": p.Error != "",
								},
							})
							if p.Error != "" {
								@field.Error() {
									{ p.Error }
								}
							}
						}
						@field.Field() {
							@field.Label(field.LabelProps{For: "password"}) {
								{ i18n.T(ctx, "auth.password") }
							}
							@input.Input(input.Props{
								ID:          "password",
								Name:        "password",
								Type:        "password",
								Value:       p.Password,
								Placeholder: i18n.T(ctx, "auth.password_placeholder"),
								Attributes: templ.Attributes{
									"required":     true,
									"autocomplete": "current-password",
									"aria-invalid": p.Error != "",
								},
							})
							if p.Error != "" {
								@field.Error() {
									{ p.Error }
								}
							}
						}
						@button.Button(button.Props{
							Type:  button.TypeSubmit,
							Class: "w-full",
						}) {
							{ i18n.T(ctx, "auth.sign_in") }
						}
					</form>
				}
			}
			@components.LanguageSwitcher()
		</div>
	}
}
