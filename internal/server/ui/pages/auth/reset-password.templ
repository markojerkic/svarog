package auth

import "github.com/markojerkic/svarog/internal/server/ui/pages"
import "github.com/markojerkic/svarog/internal/server/ui/components/card"
import "github.com/markojerkic/svarog/internal/server/ui/components/field"
import "github.com/markojerkic/svarog/internal/server/ui/components/input"
import "github.com/markojerkic/svarog/internal/server/ui/components/button"
import "github.com/markojerkic/svarog/internal/server/ui/components/alert"
import "github.com/markojerkic/svarog/internal/server/ui/components/icon"
import "github.com/markojerkic/svarog/internal/server/ui/components"
import "github.com/markojerkic/svarog/internal/server/i18n"

type ResetPasswordPageProps struct {
	Error    string
	Redirect string
}

templ ResetPasswordPage(props ...ResetPasswordPageProps) {
	{{ var p ResetPasswordPageProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	@pages.BaseLayout(pages.BaseProps{Title: i18n.T(ctx, "auth.reset_title")}) {
		<div class="fixed right-4 top-4 z-20">
			@components.LanguageSwitcher()
		</div>
		<div class="flex min-h-svh flex-col items-center justify-center gap-6 overflow-auto bg-muted/40 p-6">
			<a href="/" class="flex items-center gap-2 text-sm font-semibold">
				<img src="/assets/logo.png" alt="" class="size-7"/>
				Svarog
			</a>
			@card.Card(card.Props{Class: "w-full max-w-sm [--card-spacing:--spacing(6)]"}) {
				@card.Header() {
					@card.Title() {
						<h1 class="text-xl font-semibold tracking-tight">{ i18n.T(ctx, "auth.reset_title") }</h1>
					}
					@card.Description() {
						{ i18n.T(ctx, "auth.reset_description") }
					}
				}
				@card.Content() {
					<form
						hx-post="/reset-password"
						hx-target="#reset-error"
						hx-swap="innerHTML"
						hx-disable="input, button"
						class="space-y-4"
					>
						if p.Redirect != "" {
							<input type="hidden" name="redirect" value={ p.Redirect }/>
						}
						<div id="reset-error">
							if p.Error != "" {
								@ResetPasswordError(p.Error)
							}
						</div>
						@field.Field() {
							@field.Label(field.LabelProps{For: "password"}) {
								{ i18n.T(ctx, "auth.new_password") }
							}
							@input.Input(input.Props{
								ID:          "password",
								Name:        "password",
								Type:        "password",
								Placeholder: i18n.T(ctx, "auth.new_password_placeholder"),
								Attributes: templ.Attributes{
									"required":     true,
									"minlength":    "8",
									"autocomplete": "new-password",
								},
							})
						}
						@field.Field() {
							@field.Label(field.LabelProps{For: "repeatedPassword"}) {
								{ i18n.T(ctx, "auth.confirm_password") }
							}
							@input.Input(input.Props{
								ID:          "repeatedPassword",
								Name:        "repeatedPassword",
								Type:        "password",
								Placeholder: i18n.T(ctx, "auth.confirm_password_placeholder"),
								Attributes: templ.Attributes{
									"required":     true,
									"minlength":    "8",
									"autocomplete": "new-password",
								},
							})
						}
						@button.Button(button.Props{
							Type:  button.TypeSubmit,
							Class: "w-full",
						}) {
							{ i18n.T(ctx, "auth.reset_action") }
						}
					</form>
				}
			}
		</div>
	}
}

templ ResetPasswordError(message string) {
	@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
		@icon.CircleAlert(icon.Props{Class: "size-4"})
		@alert.Title() {
			{ i18n.T(ctx, "common.error") }
		}
		@alert.Description() {
			{ message }
		}
	}
}
