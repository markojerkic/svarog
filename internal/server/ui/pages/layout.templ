package pages

import "strings"
import "github.com/markojerkic/svarog/internal/server/i18n"

import "github.com/markojerkic/svarog/internal/server/ui/components"
import "github.com/markojerkic/svarog/internal/server/ui/components/dialog"
import "github.com/markojerkic/svarog/internal/server/ui/components/button"
import "github.com/markojerkic/svarog/internal/server/ui/components/sidebar"
import "github.com/markojerkic/svarog/internal/server/ui/components/icon"
import "github.com/markojerkic/svarog/internal/server/ui/components/tagsinput"
import "github.com/markojerkic/svarog/internal/server/ui/components/toast"
import "github.com/markojerkic/svarog/internal/server/ui/shadcnutil"
import "github.com/markojerkic/svarog/internal/lib/auth"

type BaseProps struct {
	Title string
}

templ BaseLayout(props BaseProps) {
	<!DOCTYPE html>
	<html lang={ string(i18n.LanguageFrom(ctx)) } data-i18n={ i18n.ClientCatalog(ctx) } hx-boost:inherited="true">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>
				if props.Title != "" {
					{ props.Title } - Svarog
				} else {
					Svarog
				}
			</title>
			<link href={ "/assets/css/output.css?v=" + utils.ScriptVersion } rel="stylesheet"/>
			<link rel="icon" href="/assets/logo.png" type="image/png"/>
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.0/dist/htmx.min.js" integrity="sha384-BvJpBiO8Kh31EqtJe5DRIeWrHWnCGkwytKs9NKFi86Hhw96dEqdEMzZDeK9iEGTc" crossorigin="anonymous"></script>
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.0/dist/ext/hx-ws.min.js" integrity="sha384-8iDMDuKIquXLgObstxvwGlWD1bY/ALMH7k9rbC070qmZrRvJ0BGO+8xG+Ul+J0bP" crossorigin="anonymous"></script>
			<script defer src={ utils.ScriptURL("/assets/js/session-cache.js") }></script>
			<script defer src={ utils.ScriptURL("/assets/js/i18n.js") }></script>
			<script defer src={ utils.ScriptURL("/assets/js/htmx-error-swap.js") }></script>
			<script defer src="/assets/js/copy-result-string.js"></script>
			<script defer src={ utils.ScriptURL("/assets/js/close-dialog.js") }></script>
			<script defer src={ utils.ScriptURL("/assets/js/confirm.js") }></script>
			<script defer src={ utils.ScriptURL("/assets/js/log-line-swapping.js") }></script>
			<script defer src="/assets/js/datepicker.js"></script>
			<script defer src="/assets/js/project-search.js"></script>
			@components.Scripts()
			<script type="module" src={ utils.ScriptURL("/assets/js/log-instance-colors.js") }></script>
			@tagsinput.Script()
			<script defer src={ utils.ScriptURL("/assets/js/toast-handler.js") }></script>
			<script defer src={ utils.ScriptURL("/assets/js/log-search.js") }></script>
			<script defer src={ utils.ScriptURL("/assets/js/log-menu.js") }></script>
			<script defer src={ utils.ScriptURL("/assets/js/archive-settings.js") }></script>
		</head>
		<body
			class="bg-background text-foreground min-h-svh"
			hx-indicator:inherited="#htmx-global-indicator"
		>
			<span
				class="htmx-indicator top-0 right-0 -translate-x-1/2 translate-y-1/2 fixed z-10 pointer-events-none animate-spin"
				id="htmx-global-indicator"
			>
				@icon.LoaderCircle(icon.Props{Size: 16})
			</span>
			{ children... }
			@ConfirmDialog()
			@toast.Toaster(toast.ToasterProps{Timeout: 4000})
		</body>
	</html>
}

type Props struct {
	Title string
	Class string
}

type NavItem struct {
	Title    string
	Href     string
	Icon     templ.Component
	IsActive bool
}

type AdminLayoutProps struct {
	Title         string
	CurrentPath   string
	HeaderActions templ.Component
}

func isActivePath(currentPath, menuPath string) bool {
	return strings.HasPrefix(currentPath, menuPath)
}

templ AdminLayout(props AdminLayoutProps) {
	@BaseLayout(BaseProps{Title: props.Title}) {
		@sidebar.Provider() {
			@sidebar.Sidebar(sidebar.Props{
				Collapsible: sidebar.CollapsibleIcon,
				Variant:     sidebar.VariantInset,
			}) {
				@sidebar.Header() {
					@sidebar.Menu() {
						@sidebar.MenuItem() {
							@sidebar.MenuButton(sidebar.MenuButtonProps{
								Href: "/",
								Size: sidebar.MenuButtonSizeLg,
							}) {
								<img src="/assets/logo.png" alt="" class="size-8 shrink-0"/>
								<span class="grid text-left leading-tight">
									<span class="font-semibold">Svarog</span>
									<span class="text-xs text-muted-foreground">{ i18n.T(ctx, "nav.log_explorer") }</span>
								</span>
							}
						}
					}
				}
				@sidebar.Content() {
					@sidebar.Group() {
						@sidebar.GroupLabel() {
							{ i18n.T(ctx, "nav.workspace") }
						}
						@sidebar.Menu() {
							@sidebar.MenuItem() {
								@sidebar.MenuButton(sidebar.MenuButtonProps{
									Href:     "/",
									Tooltip:  i18n.T(ctx, "nav.logs"),
									IsActive: props.CurrentPath == "/" || strings.HasPrefix(props.CurrentPath, "/logs/"),
								}) {
									@icon.Logs(icon.Props{Class: "size-4"})
									<span>{ i18n.T(ctx, "nav.logs") }</span>
								}
							}
						}
					}
					if auth.IsAdmin(ctx) {
						@sidebar.Group() {
							@sidebar.GroupLabel() {
								{ i18n.T(ctx, "nav.administration") }
							}
							@sidebar.Menu() {
								@sidebar.MenuItem() {
									@sidebar.MenuButton(sidebar.MenuButtonProps{
										Href:     "/admin/projects",
										Tooltip:  i18n.T(ctx, "nav.projects"),
										IsActive: isActivePath(props.CurrentPath, "/admin/projects"),
									}) {
										@icon.FolderKanban(icon.Props{Class: "size-4"})
										<span>{ i18n.T(ctx, "nav.projects") }</span>
									}
								}
								@sidebar.MenuItem() {
									@sidebar.MenuButton(sidebar.MenuButtonProps{
										Href:     "/admin/users",
										Tooltip:  i18n.T(ctx, "nav.users"),
										IsActive: isActivePath(props.CurrentPath, "/admin/users"),
									}) {
										@icon.Users(icon.Props{Class: "size-4"})
										<span>{ i18n.T(ctx, "nav.users") }</span>
									}
								}
							}
						}
					}
				}
				@sidebar.Footer() {
					@sidebar.Menu() {
						@sidebar.MenuItem() {
							@sidebar.MenuButton(sidebar.MenuButtonProps{
								Href:    "/logout",
								Tooltip: i18n.T(ctx, "nav.logout"),
							}) {
								@icon.LogOut(icon.Props{Class: "size-4"})
								<span>{ i18n.T(ctx, "nav.logout") }</span>
							}
						}
					}
				}
			}
			@sidebar.Inset(sidebar.InsetProps{Class: "min-w-0 h-svh overflow-hidden md:h-[calc(100svh-1rem)]"}) {
				<div class="flex h-full min-h-0 flex-col">
					<header class="flex h-14 shrink-0 items-center gap-3 border-b px-4 md:px-6">
						@sidebar.Trigger()
						<span class="h-4 w-px bg-border" aria-hidden="true"></span>
						<a href="/" class="hidden shrink-0 whitespace-nowrap text-sm text-muted-foreground hover:text-foreground xl:inline">{ i18n.T(ctx, "nav.workspace") }</a>
						@icon.ChevronRight(icon.Props{Class: "hidden size-3.5 shrink-0 text-muted-foreground xl:block"})
						<span class="truncate text-sm font-medium" aria-current="page">{ props.Title }</span>
						<div class="ml-auto flex shrink-0 items-center gap-2">
							if props.HeaderActions != nil {
								@props.HeaderActions
							}
							@components.LanguageSwitcher()
						</div>
					</header>
					<div class="flex-1 overflow-auto p-4 md:p-6 min-h-0 min-w-0">
						{ children... }
					</div>
				</div>
			}
		}
	}
}

templ ConfirmDialog() {
	@dialog.Dialog(dialog.Props{ID: "confirm-dialog"}) {
		@dialog.Content(dialog.ContentProps{}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "common.confirm_action") }
				}
				@dialog.Description() {
					<span id="confirm-message"></span>
				}
			}
			@dialog.Footer() {
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Attributes: dialog.Close(ctx),
				}) {
					{ i18n.T(ctx, "common.cancel") }
				}
				@button.Button(button.Props{
					Variant: button.VariantDefault,
					Attributes: templ.Attributes{
						"id": "confirm-button",
					},
				}) {
					{ i18n.T(ctx, "common.confirm") }
				}
			}
		}
	}
}
