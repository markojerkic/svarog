package pages

import "github.com/markojerkic/svarog/internal/server/ui/components/logs"
import "github.com/markojerkic/svarog/internal/server/ui/components/badge"
import "github.com/markojerkic/svarog/internal/server/ui/components/icon"
import "github.com/markojerkic/svarog/internal/server/logstore"
import "fmt"
import "context"
import "github.com/markojerkic/svarog/internal/server/ui/components/button"
import "strings"
import "net/url"
import "slices"
import "strconv"
import "time"
import "github.com/markojerkic/svarog/internal/server/ui/components/calendar"
import "github.com/markojerkic/svarog/internal/server/ui/components/popover"
import "github.com/markojerkic/svarog/internal/server/ui/shadcnutil"
import "github.com/markojerkic/svarog/internal/server/i18n"
import "github.com/markojerkic/svarog/internal/lib/auth"
import "github.com/markojerkic/svarog/internal/lib/logsearch"
import "github.com/markojerkic/svarog/internal/server/ui/components/archives"
import "github.com/markojerkic/svarog/internal/server/ui/components"
import "github.com/markojerkic/svarog/internal/server/ui/components/sidebar"

type LogsPageProps struct {
	LogPage            logstore.Page
	IsLastPage         bool
	Range              *LogRange
	ClientId           string
	ProjectId          string
	ClientName         string
	Instances          *[]string
	Search             string
	LogLineId          *string
	AvailableInstances []string
	ReturnSearch       string
	ReturnInstances    *[]string
	ShowTime           bool
	ShowInstance       bool
	WrapLines          *bool
}

const LogColumnsCookie = "svarog_log_columns"
const LogWrapLinesCookie = "svarog_log_wrap_lines"

func (p LogsPageProps) wrapLines(mobile bool) bool {
	if p.WrapLines == nil {
		return mobile
	}
	return *p.WrapLines
}

// Columns stay hidden unless the cookie lists them.
func LogColumns(value string) (showTime, showInstance bool) {
	for _, part := range strings.Split(value, ",") {
		switch part {
		case "time":
			showTime = true
		case "instance":
			showInstance = true
		}
	}
	return showTime, showInstance
}

func (p LogsPageProps) IsLive() bool {
	return p.Search == "" && p.LogLineId == nil && p.IsLastPage && p.Range == nil
}

func (p LogsPageProps) LivePath() string {
	return (LogsPageProps{ProjectId: p.ProjectId, ClientId: p.ClientId}).ToPath(p.Instances, nil, "", "")
}

func (p LogsPageProps) WebSocketPath() string {
	query := url.Values{}
	if p.Instances != nil {
		for _, instance := range *p.Instances {
			query.Add("instance", instance)
		}
	}
	u := url.URL{Path: fmt.Sprintf("/ws/%s/%s", p.ProjectId, p.ClientId), RawQuery: query.Encode()}
	return u.String()
}

templ LogsPage(props LogsPageProps) {
	{{ title := i18n.T(ctx, "nav.logs") }}
	if props.ClientName != "" {
		{{ title = props.ClientName }}
	}
	@adminShell(AdminLayoutProps{Title: title, CurrentPath: fmt.Sprintf("/logs/%s/%s", props.ProjectId, props.ClientId), AdminAction: archives.Trigger(props.ProjectId, props.ClientId)}) {
		<section class="log-workspace">
			<header class="log-identity">
				@sidebar.Trigger()
				<h1 title={ title }>{ title }</h1>
				<div class="log-mode">@logMode(props)</div>
			</header>
			<div class="log-preferences">
				@logDisplay(props)
				@components.LanguageSwitcher()
			</div>
			<section class="log-filters" aria-label={ i18n.T(ctx, "logs.filters") }>
				<button type="button" class="log-panel-toggle" aria-expanded="false" aria-controls="log-filter-fields">
					@icon.ListFilter(icon.Props{Size: 16})
					<span>{ i18n.T(ctx, "logs.filters") }</span>
					if filters := props.activeFilterLabels(ctx); len(filters) > 0 {
						<span class="log-count">{ strconv.Itoa(len(filters)) }</span>
						<span class="log-filter-summary">{ strings.Join(filters, " · ") }</span>
					}
					@icon.ChevronDown(icon.Props{Size: 14})
				</button>
				<div id="log-filter-fields">
					@logFilterControls(props)
				</div>
			</section>
			<div id="logs-container" class="flex h-full min-h-0 flex-col gap-3">
				if props.IsLive() {
					<div id="log-paused-notice" hidden class="shrink-0 rounded-lg border bg-muted p-3 text-sm" role="status">
						{ i18n.T(ctx, "logs.paused_notice") }
						<a class="underline underline-offset-4" href={ templ.SafeURL(props.LivePath()) } hx-target="body" hx-swap="innerHTML" hx-sync="body:replace">{ i18n.T(ctx, "logs.back_to_live") }</a>
					</div>
					<div id="log-live-notice" hidden class="shrink-0 rounded-lg border bg-muted p-3 text-sm" role="status">
						<p>{ i18n.T(ctx, "logs.live_incomplete") }</p>
						<a class="underline underline-offset-4" href={ templ.SafeURL(props.LivePath()) } hx-target="body" hx-swap="innerHTML" hx-sync="body:replace">{ i18n.T(ctx, "logs.refresh_live") }</a>
					</div>
					<template id="log-live-older-loader">
						@LogPageLoader(props, nil, "backward", "logs.load_older")
					</template>
				}
				<div
					class="flex min-h-0 flex-1 flex-col-reverse overflow-auto rounded-xl border bg-card p-2 font-mono text-[13px] leading-6"
					id="log-scroll-container"
					data-log-instances={ templ.JSONString(props.AvailableInstances) }
					data-log-client-id={ props.ClientId }
					data-show-time?={ props.ShowTime }
					data-show-instance?={ props.ShowInstance }
					if props.WrapLines != nil {
						data-wrap-lines={ strconv.FormatBool(*props.WrapLines) }
					}
					data-log-live?={ props.IsLive() }
				>
					@LogPageLines(props)
					if len(props.LogPage.Rows) == 0 {
						if props.Search != "" {
							<div class="m-auto px-4 py-12 text-center font-sans text-sm text-muted-foreground" role="status">
								{ i18n.T(ctx, "logs.no_results") }
							</div>
						} else {
							<div data-log-empty class="shrink-0 px-2 py-2 font-sans sm:px-3" role="status">
								<p class="font-medium text-foreground/80">{ i18n.T(ctx, "logs.empty") }</p>
								if props.IsLive() {
									<p class="text-muted-foreground">{ i18n.T(ctx, "logs.empty_live_description") }</p>
								}
							</div>
						}
					}
				</div>
			</div>
		</section>
		@logs.SharedLogMenu()
		@logs.SearchDialog(fmt.Sprintf("/logs/%s/%s", props.ProjectId, props.ClientId), props.Search, props.Instances, props.Range.Query())
		if auth.IsAdmin(ctx) {
			@archives.SettingsSheet()
		}
	}
	<script type="text/javascript">
		(function positionLogs() {
			const logsContainer = document.getElementById("log-scroll-container");
			const anchor = logsContainer.querySelector("[data-log-anchor]");
			if (anchor) {
				anchor.scrollIntoView({ block: "center", inline: "nearest" });
			} else {
				logsContainer.scrollTop = 0;
			}
		})();
	</script>
}

templ logViewMenuItem(option string, pressed bool, label string) {
	@button.Button(button.Props{
		Variant: button.VariantGhost,
		Size:    button.SizeSm,
		Class:   "w-full justify-start gap-2 aria-pressed:bg-accent aria-pressed:text-accent-foreground",
		Attributes: templ.Attributes{
			"data-log-option": option,
			"aria-pressed":    strconv.FormatBool(pressed),
		},
	}) {
		{ children... }
		{ label }
	}
}

templ logMode(props LogsPageProps) {
	if props.LogLineId != nil {
		<span data-log-view-status>{ i18n.T(ctx, "logs.context") }</span>
		if props.ReturnSearch != "" {
			@button.Button(button.Props{
				Href:    props.ToPath(props.ReturnInstances, nil, "", props.ReturnSearch),
				Variant: button.VariantOutline, Size: button.SizeSm,
				Attributes: templ.Attributes{
					"hx-sync":    "body:replace",
					"aria-label": i18n.T(ctx, "logs.back_to_results"),
				},
			}) {
				@icon.ArrowLeft(icon.Props{Class: "size-3.5"})
				<span>{ i18n.T(ctx, "logs.back_to_results") }</span>
			}
		}
	} else if !props.IsLive() {
		<span data-log-view-status class="whitespace-nowrap text-xs text-muted-foreground md:shrink-0" title={ i18n.T(ctx, "logs.not_live") }>
			if props.Search != "" {
				{ i18n.T(ctx, "logs.search_results") }
			} else {
				{ i18n.T(ctx, "logs.not_live") }
			}
		</span>
	} else {
		<span
			id="log-live-status"
			data-log-view-status
			class="whitespace-nowrap text-xs text-muted-foreground md:shrink-0"
			role="status"
			data-live-label={ i18n.T(ctx, "logs.live") }
			data-stale-label={ i18n.T(ctx, "logs.live_interrupted") }
			data-paused-label={ i18n.T(ctx, "logs.paused") }
		>{ i18n.T(ctx, "logs.connecting") }</span>
		@button.Button(button.Props{
			Variant: button.VariantGhost, Size: button.SizeSm,
			Class: "max-md:px-2",
			Attributes: templ.Attributes{
				"data-log-pause": true,
				"aria-label":     i18n.T(ctx, "logs.pause"),
			},
		}) {
			@icon.Pause(icon.Props{Class: "size-3.5"})
			<span>{ i18n.T(ctx, "logs.pause") }</span>
		}
	}
	if !props.IsLive() {
		@button.Button(button.Props{
			Href:       props.LivePath(),
			Variant:    button.VariantGhost,
			Size:       button.SizeSm,
			Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "logs.back_to_live"), "title": i18n.T(ctx, "logs.back_to_live"), "hx-sync": "body:replace"},
		}) {
			@icon.Radio(icon.Props{Class: "size-3.5"})
			<span>{ i18n.T(ctx, "logs.back_to_live") }</span>
		}
	}
}

func formatLogDate(ctx context.Context, iso string) string {
	parsed, err := time.Parse("2006-01-02", iso)
	if err != nil {
		return iso
	}
	if i18n.LanguageFrom(ctx) == i18n.Croatian {
		return parsed.Format("2. 1. 2006.")
	}
	return parsed.Format("2 Jan 2006")
}

func (p LogsPageProps) activeFilterLabels(ctx context.Context) []string {
	var parts []string
	if p.Search != "" {
		parts = append(parts, p.Search)
	}
	if p.Range != nil {
		parts = append(parts, logRangeLabel(ctx, p.Range))
	}
	if p.Instances != nil {
		for _, instance := range *p.Instances {
			parts = append(parts, logInstanceLabel(ctx, instance))
		}
	}
	return parts
}

templ logFilterControls(props LogsPageProps) {
	<div class="log-filter-field log-search-field">
		<span class="log-field-label">{ i18n.T(ctx, "logs.search") }</span>
		<div class="log-field-control">
			@logs.SearchTrigger(props.Search)
			if props.Search != "" {
				@clearLogFilter(props.ToPath(props.Instances, nil, "", ""), i18n.T(ctx, "logs.clear_search"))
			}
		</div>
	</div>
	<div class="log-filter-field">
		<span class="log-field-label">{ i18n.T(ctx, "logs.date_range") }</span>
		<div class="log-field-control">
			@LogRangeFilter(props)
			if props.Range != nil {
				{{
					cleared := props
					cleared.Range = nil
				}}
				@clearLogFilter(cleared.ToPath(props.Instances, nil, "", props.Search), i18n.T(ctx, "logs.clear_range"))
			}
		</div>
	</div>
	<div class="log-filter-field log-instances-field">
		<div class="log-instance-picker">@LogInstanceFilters(props)</div>
		<div class="log-panel-instances">
			<h3 class="log-field-label">{ i18n.T(ctx, "logs.instances") }</h3>
			@instanceFilterForm(props, "log-panel-instance-form")
		</div>
	</div>
	if props.Instances != nil && len(*props.Instances) > 0 {
		@InstanceFilter(props)
	}
}

templ clearLogFilter(path, label string) {
	<a class="log-clear" href={ templ.SafeURL(path) } aria-label={ label } title={ label } hx-target="body" hx-swap="innerHTML" hx-sync="body:replace">
		@icon.X(icon.Props{Size: 13})
	</a>
}

func logRangeLabel(ctx context.Context, r *LogRange) string {
	if r == nil {
		return i18n.T(ctx, "logs.date_range")
	}
	if r.FromDate == "" {
		return r.From.UTC().Format("02 Jan 15:04") + " – " + r.To.UTC().Format("02 Jan 15:04") + " UTC"
	}
	if r.FromDate == r.ToDate {
		return formatLogDate(ctx, r.FromDate)
	}
	return formatLogDate(ctx, r.FromDate) + " – " + formatLogDate(ctx, r.ToDate)
}

templ LogRangeFilter(props LogsPageProps) {
	{{
		label := logRangeLabel(ctx, props.Range)
		selected := calendar.DateRange{}
		fromValue, toValue := "", ""
		timeQuery := props.Range.Query()
		if props.Range != nil {
			from, fromErr := time.Parse("2006-01-02", props.Range.FromDate)
			to, toErr := time.Parse("2006-01-02", props.Range.ToDate)
			if fromErr == nil && toErr == nil {
				selected = calendar.DateRange{From: from, To: to}
			}
			fromValue = props.Range.FromDate
			toValue = props.Range.ToDate
		}
		action := fmt.Sprintf("/logs/%s/%s", props.ProjectId, props.ClientId)
		cleared := props
		cleared.Range = nil
		clearPath := cleared.ToPath(props.Instances, nil, "", props.Search)
	}}
	@popover.Popover(popover.Props{ID: "log-range"}) {
		@button.Button(button.Props{
			Variant: button.VariantGhost,
			Size:    button.SizeSm,
			Class:   "gap-1.5 max-md:px-2",
			Attributes: utils.MergeAttributes(popover.Trigger(ctx), templ.Attributes{
				"aria-label": label,
				"title":      i18n.T(ctx, "logs.date_range"),
			}),
		}) {
			@icon.Calendar(icon.Props{Class: "size-3.5"})
			<span class="min-w-0 truncate">{ label }</span>
		}
		@popover.Content(popover.ContentProps{Align: popover.AlignEnd, Class: "max-h-[65dvh] w-auto max-w-[calc(100vw-2rem)] overflow-auto p-3"}) {
			<form
				id="log-time-range-form"
				method="get"
				action={ templ.SafeURL(action) }
				hx-get={ action }
				hx-target="body"
				hx-swap="innerHTML"
				hx-push-url="true"
				hx-sync="body:replace"
				class="space-y-2 border-b pb-2"
			>
				@QueryFilterFields(props)
				<input type="hidden" name="fromAt" value={ timeQuery.Get("fromAt") }/>
				<input type="hidden" name="toAt" value={ timeQuery.Get("toAt") }/>
				<div class="flex flex-wrap gap-1">
					@LogRangePreset("15", i18n.T(ctx, "logs.last_15_minutes"))
					@LogRangePreset("60", i18n.T(ctx, "logs.last_hour"))
					@LogRangePreset("today", i18n.T(ctx, "logs.today"))
				</div>
				<details class="text-sm">
					<summary class="cursor-pointer">{ i18n.T(ctx, "logs.precise_range") }</summary>
					<div class="mt-2 flex flex-col gap-2">
						<label>{ i18n.T(ctx, "logs.time_from") } <input type="datetime-local" step="1" data-log-time-from class="block w-full rounded-md border p-1"/></label>
						<label>{ i18n.T(ctx, "logs.time_to") } <input type="datetime-local" step="1" data-log-time-to class="block w-full rounded-md border p-1"/></label>
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Class: "self-end"}) {
							{ i18n.T(ctx, "logs.apply_range") }
						}
					</div>
				</details>
			</form>
			<form
				id="log-range-form"
				method="get"
				action={ templ.SafeURL(action) }
				hx-get={ action }
				hx-target="body"
				hx-swap="innerHTML"
				hx-push-url="true"
				hx-sync="body:replace"
				class="space-y-2"
			>
				@QueryFilterFields(props)
				<input type="hidden" name="from" value={ fromValue }/>
				<input type="hidden" name="to" value={ toValue }/>
				<input type="hidden" name="offset" value="0"/>
				@calendar.Calendar(calendar.Props{
					ID:           "log-range-calendar",
					Mode:         calendar.ModeRange,
					Locale:       i18n.Locale(ctx),
					Selected:     selected,
					DefaultMonth: selected.From,
				})
				<div class="flex items-center justify-end gap-2">
					if props.Range != nil {
						<a href={ templ.SafeURL(clearPath) } class="text-sm text-muted-foreground hover:text-foreground" hx-target="body" hx-swap="innerHTML">{ i18n.T(ctx, "logs.clear_range") }</a>
					}
					@button.Button(button.Props{
						Type:       button.TypeSubmit,
						Variant:    button.VariantDefault,
						Size:       button.SizeSm,
						Attributes: templ.Attributes{"disabled": fromValue == ""},
					}) {
						{ i18n.T(ctx, "logs.apply_dates") }
					}
				</div>
			</form>
		}
	}
}

templ QueryFilterFields(props LogsPageProps) {
	if props.Search != "" {
		<input type="hidden" name="search" value={ props.Search }/>
	}
	if props.Instances != nil {
		for _, instance := range *props.Instances {
			<input type="hidden" name="instance" value={ instance }/>
		}
	}
}

templ LogRangePreset(preset, label string) {
	@button.Button(button.Props{
		Type: button.TypeButton, Variant: button.VariantOutline, Size: button.SizeSm,
		Attributes: templ.Attributes{"data-log-range-preset": preset},
	}) {
		{ label }
	}
}

func clearLogInstancesPath(props LogsPageProps) string {
	return props.ToPath(nil, nil, "", props.Search)
}

func logInstanceOptions(props LogsPageProps) []string {
	options := slices.Clone(props.AvailableInstances)
	if props.Instances != nil {
		for _, instance := range *props.Instances {
			if !slices.Contains(options, instance) {
				options = append(options, instance)
			}
		}
	}
	return options
}

func logInstanceLabel(ctx context.Context, instance string) string {
	if instance == "" {
		return i18n.T(ctx, "logs.unnamed_instance")
	}
	return instance
}

templ LogInstanceFilters(props LogsPageProps) {
	{{ active := props.Instances != nil && len(*props.Instances) > 0 }}
	@popover.Popover(popover.Props{ID: "log-instance-filters"}) {
		@button.Button(button.Props{
			Variant:    button.VariantOutline,
			Size:       button.SizeSm,
			Attributes: popover.Trigger(ctx),
		}) {
			@icon.Server(icon.Props{Class: "size-3.5"})
			if active {
				{ i18n.T(ctx, "logs.instances") }
				<span class="log-count">{ strconv.Itoa(len(*props.Instances)) }</span>
			} else {
				{ i18n.T(ctx, "logs.all_instances") }
			}
		}
		@popover.Content(popover.ContentProps{Align: popover.AlignEnd, Class: "max-w-[calc(100vw-2rem)] gap-2 p-3"}) {
			@popover.Title(popover.TitleProps{Class: "text-sm font-medium"}) {
				{ i18n.T(ctx, "logs.instances") }
			}
			@instanceFilterForm(props, "log-instance-form")
		}
	}
}

templ instanceFilterForm(props LogsPageProps, id string) {
	{{ active := props.Instances != nil && len(*props.Instances) > 0 }}
	<form
		id={ id }
		data-log-instance-form
		method="get"
		action={ templ.SafeURL(fmt.Sprintf("/logs/%s/%s", props.ProjectId, props.ClientId)) }
		hx-boost="true"
		hx-target="body"
		hx-swap="innerHTML"
		hx-push-url="true"
		hx-sync="body:replace"
		class="space-y-2"
	>
		if props.Search != "" {
			<input type="hidden" name="search" value={ props.Search }/>
		}
		@logs.QueryFields(props.Range.Query())
		<div class="log-instance-options max-h-52 overflow-auto">
			for _, instance := range logInstanceOptions(props) {
				<label class="flex min-w-0 items-center gap-2 rounded-md px-1 py-1.5 text-sm hover:bg-accent">
					<input type="checkbox" name="instance" value={ instance } checked?={ active && slices.Contains(*props.Instances, instance) }/>
					<span class="wrap-anywhere">{ logInstanceLabel(ctx, instance) }</span>
				</label>
			}
		</div>
		<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "logs.no_instance_selection") }</p>
		<div class="flex flex-wrap items-center justify-end gap-2">
			if active {
				<a
					href={ templ.SafeURL(clearLogInstancesPath(props)) }
					class="text-sm text-muted-foreground hover:text-foreground"
					data-log-instance-filter
					hx-target="body"
					hx-swap="innerHTML"
					hx-sync="body:replace"
				>{ i18n.T(ctx, "logs.clear_filters") }</a>
			}
			@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
				{ i18n.T(ctx, "logs.apply_filters") }
			}
		</div>
	</form>
}

templ logDisplay(props LogsPageProps) {
	@popover.Popover(popover.Props{ID: "log-display"}) {
		@button.Button(button.Props{
			Variant: button.VariantOutline,
			Size:    button.SizeSm,
			Attributes: utils.MergeAttributes(popover.Trigger(ctx), templ.Attributes{
				"aria-label": i18n.T(ctx, "logs.display"),
				"title":      i18n.T(ctx, "logs.display"),
			}),
		}) {
			@icon.SlidersHorizontal(icon.Props{Class: "size-3.5"})
			<span class="max-sm:sr-only">{ i18n.T(ctx, "logs.display") }</span>
		}
		@popover.Content(popover.ContentProps{
			Align: popover.AlignEnd,
			Class: "w-fit gap-1",
		}) {
			@logViewMenuItem("time", props.ShowTime, i18n.T(ctx, "logs.show_time")) {
				@icon.Clock(icon.Props{Class: "size-3.5", Attributes: templ.Attributes{"aria-hidden": "true"}})
			}
			@logViewMenuItem("instance", props.ShowInstance, i18n.T(ctx, "logs.show_instance")) {
				@icon.Server(icon.Props{Class: "size-3.5", Attributes: templ.Attributes{"aria-hidden": "true"}})
			}
			<div class="hidden md:block">
				@logWrapMenuItem(props.wrapLines(false))
			</div>
			<div class="md:hidden">
				@logWrapMenuItem(props.wrapLines(true))
			</div>
		}
	}
}

templ logWrapMenuItem(pressed bool) {
	@logViewMenuItem("wrap", pressed, i18n.T(ctx, "logs.wrap_lines")) {
		@icon.TextWrap(icon.Props{Class: "size-3.5", Attributes: templ.Attributes{"aria-hidden": "true"}})
	}
}

templ InstanceFilter(props LogsPageProps) {
	<div class="log-instance-chips" role="group" aria-label={ i18n.T(ctx, "logs.filtered_by_instance") }>
		for index, instance := range *props.Instances {
			{{
				label := logInstanceLabel(ctx, instance)
				remaining := slices.Delete(slices.Clone(*props.Instances), index, index+1)
				removeLabel := i18n.Format(ctx, i18n.Message{ID: "logs.remove_instance_filter", Data: map[string]any{"Name": label}})
			}}
			@badge.Badge(badge.Props{
				Href:    props.ToPath(&remaining, nil, "", props.Search),
				Variant: badge.VariantSecondary,
				Class:   "cursor-pointer gap-1.5",
				Attributes: templ.Attributes{
					"aria-label":               removeLabel,
					"title":                    removeLabel,
					"data-log-instance-filter": true,
					"hx-target":                "body",
					"hx-swap":                  "innerHTML",
					"hx-sync":                  "body:replace",
				},
			}) {
				<span class="min-w-0 truncate">{ label }</span>
				@icon.X(icon.Props{Size: 12})
			}
		}
		if len(*props.Instances) > 1 {
			<a
				href={ templ.SafeURL(clearLogInstancesPath(props)) }
				class="log-clear-all-instances text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
				data-log-instance-filter
				hx-target="body"
				hx-swap="innerHTML"
				hx-sync="body:replace"
			>{ i18n.T(ctx, "logs.clear_instance_filters") }</a>
		}
	</div>
}

templ LogPageLines(props LogsPageProps) {
	// HTTP validation has already accepted the query; prepare it once per page.
	{{ search, _ := logsearch.Parse(props.Search) }}
	if props.LogPage.Newer != nil {
		@LogPageLoader(props, props.LogPage.Newer, "forward", "logs.load_newer")
	}
	for _, log := range props.LogPage.Rows {
		@logs.LogLine(logs.LogLineProps{
			Row:       log,
			Search:    search,
			IsContext: props.LogLineId != nil && *props.LogLineId == strconv.FormatInt(log.ID, 10),
		})
	}
	if props.LogPage.Older != nil {
		@LogPageLoader(props, props.LogPage.Older, "backward", "logs.load_older")
	}
	if props.IsLive() {
		<div
			hx-ws:connect={ props.WebSocketPath() }
			hx-config="ws.pauseOnBackground:false ws.reconnect:false"
			data-log-stream
		></div>
	}
}

templ LogPageLoader(props LogsPageProps, cursor *logstore.Cursor, direction, label string) {
	<div
		data-log-page={ direction }
		hx-get={ props.ToPath(props.Instances, cursor, direction, props.Search) }
		hx-swap="outerHTML"
		hx-trigger="intersect once root:#log-scroll-container rootMargin:160px, click"
		hx-sync="body:abort"
		hx-disable="find button"
		hx-push-url="false"
		class="flex shrink-0 justify-center py-1"
	>
		@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm}) {
			{ i18n.T(ctx, label) }
		}
	</div>
}
