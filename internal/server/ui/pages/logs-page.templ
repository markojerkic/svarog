package pages

import "github.com/markojerkic/svarog/internal/server/ui/components/logs"
import "github.com/markojerkic/svarog/internal/server/ui/components/badge"
import "github.com/markojerkic/svarog/internal/server/ui/components/icon"
import "github.com/markojerkic/svarog/internal/server/db"
import "fmt"
import "context"
import "github.com/markojerkic/svarog/internal/server/ui/components/button"
import "strings"
import "net/url"
import "slices"
import "strconv"
import "time"
import "github.com/markojerkic/svarog/internal/server/ui/components/calendar"
import "github.com/markojerkic/svarog/internal/server/ui/components/popover"
import "github.com/markojerkic/svarog/internal/server/ui/shadcnutil"
import "github.com/markojerkic/svarog/internal/server/i18n"
import "github.com/markojerkic/svarog/internal/lib/auth"
import "github.com/markojerkic/svarog/internal/lib/logsearch"
import "github.com/markojerkic/svarog/internal/server/ui/components/archives"

type LogsPageProps struct {
	LogPage            db.LogPage
	ClientId           string
	ProjectId          string
	ClientName         string
	Instances          *[]string
	Search             string
	LogLineId          *string
	AvailableInstances []string
	ShowTime           bool
	ShowInstance       bool
}

const LogColumnsCookie = "svarog_log_columns"

// Columns stay hidden unless the cookie lists them.
func LogColumns(value string) (showTime, showInstance bool) {
	for _, part := range strings.Split(value, ",") {
		switch part {
		case "time":
			showTime = true
		case "instance":
			showInstance = true
		}
	}
	return showTime, showInstance
}

func (p LogsPageProps) IsLive() bool {
	return p.Search == "" && p.Instances == nil && p.LogLineId == nil && p.LogPage.IsLastPage && p.LogPage.Range == nil
}

templ LogsPage(props LogsPageProps) {
	{{ title := i18n.T(ctx, "nav.logs") }}
	if props.ClientName != "" {
		{{ title = props.ClientName }}
	}
	@AdminLayout(AdminLayoutProps{Title: title, CurrentPath: fmt.Sprintf("/logs/%s/%s", props.ProjectId, props.ClientId), HeaderActions: LogsHeaderActions(props)}) {
		<div id="logs-container" class="flex h-full min-h-0 flex-col gap-3">
			if props.Search == "" && props.Instances != nil && len(*props.Instances) > 0 {
				@InstanceFilter(props)
			}
			<div
				class="flex min-h-0 flex-1 flex-col-reverse overflow-auto rounded-xl border bg-card p-2 font-mono text-[13px] leading-6"
				id="log-scroll-container"
				data-log-instances={ templ.JSONString(props.AvailableInstances) }
				data-log-client-id={ props.ClientId }
				data-show-time?={ props.ShowTime }
				data-show-instance?={ props.ShowInstance }
			>
				@LogPageLines(props)
				if len(props.LogPage.Logs) == 0 {
					if props.Search != "" {
						<div class="m-auto px-4 py-12 text-center font-sans text-sm text-muted-foreground" role="status">
							{ i18n.T(ctx, "logs.no_results") }
						</div>
					} else {
						<div data-log-empty class="shrink-0 px-2 py-2 font-sans sm:px-3" role="status">
							<p class="font-medium text-foreground/80">{ i18n.T(ctx, "logs.empty") }</p>
							if props.IsLive() {
								<p class="text-muted-foreground">{ i18n.T(ctx, "logs.empty_live_description") }</p>
							}
						</div>
					}
				}
			</div>
		</div>
		@logs.SharedLogMenu()
		@logs.SearchDialog(fmt.Sprintf("/logs/%s/%s", props.ProjectId, props.ClientId), props.Search, props.Instances)
		if auth.IsAdmin(ctx) {
			@archives.SettingsSheet()
		}
	}
	<script type="text/javascript">
		(function positionLogs() {
			const logsContainer = document.getElementById("log-scroll-container");
			const anchor = logsContainer.querySelector("[data-log-anchor]");
			if (anchor) {
				anchor.scrollIntoView({ block: "center", inline: "nearest" });
			} else {
				logsContainer.scrollTop = 0;
			}
		})();
	</script>
}

templ logColumnToggle(column string, pressed bool, label string) {
	@button.Button(button.Props{
		Variant: button.VariantGhost,
		Size:    button.SizeIconSm,
		Class:   "aria-pressed:bg-accent aria-pressed:text-accent-foreground",
		Attributes: templ.Attributes{
			"data-log-column": column,
			"aria-pressed":    strconv.FormatBool(pressed),
			"aria-label":      label,
			"title":           label,
		},
	}) {
		{ children... }
	}
}

templ LogsHeaderActions(props LogsPageProps) {
	if props.LogLineId != nil {
		<span class="whitespace-nowrap text-xs text-muted-foreground">{ i18n.T(ctx, "logs.context") }</span>
	} else if !props.IsLive() {
		<span class="hidden text-xs text-muted-foreground 2xl:inline">{ i18n.T(ctx, "logs.not_live") }</span>
	}
	@logs.SearchTrigger(props.Search)
	@LogRangeFilter(props)
	@logColumnToggle("time", props.ShowTime, i18n.T(ctx, "logs.show_time")) {
		@icon.Clock(icon.Props{Class: "size-3.5", Attributes: templ.Attributes{"aria-hidden": "true"}})
	}
	@logColumnToggle("instance", props.ShowInstance, i18n.T(ctx, "logs.show_instance")) {
		@icon.Server(icon.Props{Class: "size-3.5", Attributes: templ.Attributes{"aria-hidden": "true"}})
	}
	if props.Search != "" {
		@button.Button(button.Props{
			Href:    props.LogPage.ToPath(props.ProjectId, props.ClientId, props.Instances, nil, "", ""),
			Variant: button.VariantGhost,
			Size:    button.SizeIconSm,
			Attributes: templ.Attributes{
				"aria-label": i18n.T(ctx, "logs.clear_search"),
				"title":      i18n.T(ctx, "logs.clear_search"),
				"hx-target":  "body",
				"hx-swap":    "innerHTML",
				"hx-sync":    "body:replace",
			},
		}) {
			@icon.X(icon.Props{Class: "size-3.5"})
		}
		@LogInstanceFilters(props)
	}
	if !props.IsLive() {
		@button.Button(button.Props{
			Href:       fmt.Sprintf("/logs/%s/%s", props.ProjectId, props.ClientId),
			Variant:    button.VariantGhost,
			Size:       button.SizeSm,
			Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "logs.back_to_live"), "title": i18n.T(ctx, "logs.back_to_live"), "hx-sync": "body:replace"},
		}) {
			@icon.ArrowLeft(icon.Props{Class: "size-3.5"})
			<span class="hidden xl:inline">{ i18n.T(ctx, "logs.back_to_live") }</span>
		}
	}
	if auth.IsAdmin(ctx) {
		@archives.Trigger(props.ProjectId, props.ClientId)
	}
}

func formatLogDate(ctx context.Context, iso string) string {
	parsed, err := time.Parse("2006-01-02", iso)
	if err != nil {
		return iso
	}
	if i18n.LanguageFrom(ctx) == i18n.Croatian {
		return parsed.Format("2. 1. 2006.")
	}
	return parsed.Format("2 Jan 2006")
}

templ LogRangeFilter(props LogsPageProps) {
	{{
		label := i18n.T(ctx, "logs.date_range")
		selected := calendar.DateRange{}
		fromValue, toValue := "", ""
		if props.LogPage.Range != nil {
			from, fromErr := time.Parse("2006-01-02", props.LogPage.Range.FromDate)
			to, toErr := time.Parse("2006-01-02", props.LogPage.Range.ToDate)
			if fromErr == nil && toErr == nil {
				selected = calendar.DateRange{From: from, To: to}
			}
			fromValue = props.LogPage.Range.FromDate
			toValue = props.LogPage.Range.ToDate
			label = formatLogDate(ctx, fromValue) + " – " + formatLogDate(ctx, toValue)
		}
		action := fmt.Sprintf("/logs/%s/%s", props.ProjectId, props.ClientId)
		cleared := props.LogPage
		cleared.Range = nil
		clearPath := cleared.ToPath(props.ProjectId, props.ClientId, props.Instances, nil, "", props.Search)
	}}
	@popover.Popover(popover.Props{ID: "log-range"}) {
		@button.Button(button.Props{
			Variant: button.VariantGhost,
			Size:    button.SizeSm,
			Class:   "gap-1.5",
			Attributes: utils.MergeAttributes(popover.Trigger(ctx), templ.Attributes{
				"aria-label": label,
				"title":      i18n.T(ctx, "logs.date_range"),
			}),
		}) {
			@icon.Calendar(icon.Props{Class: "size-3.5"})
			<span class="hidden max-w-40 truncate lg:inline">{ label }</span>
		}
		@popover.Content(popover.ContentProps{Align: popover.AlignEnd, Class: "w-auto p-2"}) {
			<form
				id="log-range-form"
				method="get"
				action={ templ.SafeURL(action) }
				hx-get={ action }
				hx-target="body"
				hx-swap="innerHTML"
				hx-push-url="true"
				class="space-y-2"
			>
				if props.Search != "" {
					<input type="hidden" name="search" value={ props.Search }/>
				}
				if props.Instances != nil {
					for _, instance := range *props.Instances {
						<input type="hidden" name="instance" value={ instance }/>
					}
				}
				<input type="hidden" name="from" value={ fromValue }/>
				<input type="hidden" name="to" value={ toValue }/>
				<input type="hidden" name="offset" value="0"/>
				@calendar.Calendar(calendar.Props{
					ID:           "log-range-calendar",
					Mode:         calendar.ModeRange,
					Locale:       i18n.Locale(ctx),
					Selected:     selected,
					DefaultMonth: selected.From,
				})
				<div class="flex items-center justify-end gap-2">
					if props.LogPage.Range != nil {
						<a href={ templ.SafeURL(clearPath) } class="text-sm text-muted-foreground hover:text-foreground" hx-target="body" hx-swap="innerHTML">{ i18n.T(ctx, "logs.clear_range") }</a>
					}
					@button.Button(button.Props{
						Type:    button.TypeSubmit,
						Variant: button.VariantDefault,
						Size:    button.SizeSm,
					}) {
						{ i18n.T(ctx, "logs.apply_range") }
					}
				</div>
			</form>
		}
	}
}

func logInstanceFilterPath(props LogsPageProps, instance *string) string {
	query := url.Values{"search": {props.Search}}
	if instance != nil {
		query.Set("instance", *instance)
	}
	u := url.URL{
		Path:     fmt.Sprintf("/logs/%s/%s", props.ProjectId, props.ClientId),
		RawQuery: query.Encode(),
	}
	return u.String()
}

templ LogInstanceFilters(props LogsPageProps) {
	{{
		active := props.Instances != nil && len(*props.Instances) > 0
		label, title := i18n.T(ctx, "logs.filters"), i18n.T(ctx, "logs.all_instances")
		if active {
			label = i18n.T(ctx, "logs.active_filters")
			title = i18n.Format(ctx, i18n.Message{ID: "logs.selected_instances", Data: map[string]any{"Names": strings.Join(*props.Instances, ", ")}})
		}
		optionClass := "flex min-w-0 items-center gap-2 rounded-md px-2 py-1.5 text-sm outline-none hover:bg-accent focus-visible:bg-accent aria-[current=true]:bg-accent"
	}}
	@popover.Popover(popover.Props{ID: "log-instance-filters"}) {
		@button.Button(button.Props{
			Variant: button.VariantGhost,
			Size:    button.SizeSm,
			Class:   "gap-1.5",
			Attributes: utils.MergeAttributes(popover.Trigger(ctx), templ.Attributes{
				"aria-label": label,
				"title":      title,
			}),
		}) {
			@icon.Funnel(icon.Props{Class: "size-3.5"})
			<span class="hidden lg:inline">{ i18n.T(ctx, "logs.filters") }</span>
			if active {
				<span class="flex size-4 items-center justify-center rounded bg-secondary text-[10px] font-medium">1</span>
			}
		}
		@popover.Content(popover.ContentProps{
			Align: popover.AlignEnd,
			Class: "max-w-[calc(100vw-2rem)] gap-1 p-1",
			Attributes: templ.Attributes{
				"hx-target:inherited": "body",
				"hx-swap:inherited":   "innerHTML",
				"hx-sync:inherited":   "body:replace",
			},
		}) {
			@popover.Title(popover.TitleProps{Class: "px-2 py-1 text-xs text-muted-foreground"}) {
				{ i18n.T(ctx, "logs.instance") }
			}
			<div class="max-h-64 overflow-auto">
				<a
					href={ templ.SafeURL(logInstanceFilterPath(props, nil)) }
					class={ optionClass }
					data-log-instance-filter
					if !active {
						aria-current="true"
					}
				>
					<span class="flex-1">{ i18n.T(ctx, "logs.all_instances") }</span>
					if !active {
						@icon.Check(icon.Props{Class: "size-3.5 shrink-0"})
					}
				</a>
				for _, instance := range props.AvailableInstances {
					{{ selected := active && slices.Contains(*props.Instances, instance) }}
					<a
						href={ templ.SafeURL(logInstanceFilterPath(props, &instance)) }
						class={ optionClass }
						title={ instance }
						data-log-instance-filter
						if selected {
							aria-current="true"
						}
					>
						<span class="min-w-0 flex-1 truncate">{ instance }</span>
						if selected {
							@icon.Check(icon.Props{Class: "size-3.5 shrink-0"})
						}
					</a>
				}
			</div>
			if active {
				<div class="mt-1 border-t pt-1">
					<a href={ templ.SafeURL(logInstanceFilterPath(props, nil)) } class={ optionClass + " text-muted-foreground" } data-log-instance-filter>
						{ i18n.T(ctx, "logs.clear_filters") }
					</a>
				</div>
			}
		}
	}
}

templ InstanceFilter(props LogsPageProps) {
	<div class="flex shrink-0 flex-wrap items-center gap-2">
		<span class="text-sm text-muted-foreground">{ i18n.T(ctx, "logs.filtered_by_instance") }</span>
		@badge.Badge(badge.Props{
			Href:    fmt.Sprintf("/logs/%s/%s", props.ProjectId, props.ClientId),
			Variant: badge.VariantDefault,
			Class:   "cursor-pointer gap-1.5",
			Attributes: templ.Attributes{
				"aria-label": i18n.T(ctx, "logs.clear_instance_filter"),
				"hx-target":  "body",
				"hx-swap":    "innerHTML",
				"hx-sync":    "body:replace",
			},
		}) {
			<span>{ strings.Join(*props.Instances, ", ") }</span>
			@icon.X(icon.Props{Size: 12})
		}
	</div>
}

templ LogPageLines(props LogsPageProps) {
	// HTTP validation has already accepted the query; prepare it once per page.
	{{ search, _ := logsearch.Parse(props.Search) }}
	if props.LogPage.ForwardCursor != nil {
		@LogPageLoader(props, props.LogPage.ForwardCursor, "forward", "logs.load_newer")
	}
	for _, log := range props.LogPage.Logs {
		@logs.LogLine(logs.LogLineProps{
			LogLine:   log,
			Search:    search,
			IsContext: props.LogLineId != nil && *props.LogLineId == strconv.FormatInt(log.ID, 10),
		})
	}
	if props.LogPage.BackwardCursor != nil {
		@LogPageLoader(props, props.LogPage.BackwardCursor, "backward", "logs.load_older")
	}
	if props.IsLive() {
		<div
			hx-ws:connect={ fmt.Sprintf("/ws/%s/%s", props.ProjectId, props.ClientId) }
			hx-config="ws: {pauseOnBackground: false}"
		></div>
	}
}

templ LogPageLoader(props LogsPageProps, cursor *db.LastCursor, direction, label string) {
	<div
		data-log-page={ direction }
		hx-get={ props.LogPage.ToPath(props.ProjectId, props.ClientId, props.Instances, cursor, direction, props.Search) }
		hx-swap="outerHTML"
		hx-trigger="intersect once root:#log-scroll-container rootMargin:160px, click"
		hx-sync="body:abort"
		hx-disable="find button"
		hx-push-url="false"
		class="flex shrink-0 justify-center py-1"
	>
		@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm}) {
			{ i18n.T(ctx, label) }
		}
	</div>
}
