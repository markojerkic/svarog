package pages

import "net/url"
import "strconv"
import "github.com/markojerkic/svarog/internal/lib/archive"
import "github.com/markojerkic/svarog/internal/lib/logsearch"
import "github.com/markojerkic/svarog/internal/server/i18n"
import "github.com/markojerkic/svarog/internal/server/ui/components"
import "github.com/markojerkic/svarog/internal/server/ui/components/button"
import "github.com/markojerkic/svarog/internal/server/ui/components/icon"
import "github.com/markojerkic/svarog/internal/server/ui/components/logs"
import "github.com/markojerkic/svarog/internal/server/ui/components/sidebar"

type ArchiveContextProps struct {
	Window                  archive.HitContext
	Ref                     archive.HitRef
	Lines                   int
	ProjectID, ClientID     string
	ArchivePath, SearchPath string
	BackParams              url.Values
	Display                 LogDisplayOptions
}

func (p ArchiveContextProps) pageURL(hit archive.SearchHit, direction string) string {
	q := url.Values{"entry": {hit.Entry}, "line": {strconv.Itoa(hit.Line)}, "direction": {direction}}
	return p.ArchivePath + "/context?" + q.Encode()
}

templ ArchiveContext(p ArchiveContextProps) {
	{{
		title := i18n.T(ctx, "archives.context")
		back := p.SearchPath
		if len(p.BackParams) > 0 {
			back += "?" + p.BackParams.Encode()
		}
		download := url.Values{"entry": {p.Ref.Entry}, "line": {strconv.Itoa(p.Ref.Line)}, "lines": {strconv.Itoa(p.Lines)}}
	}}
	@adminShell(AdminLayoutProps{Title: title, CurrentPath: p.SearchPath}) {
		<section class="log-workspace">
			<header class="log-identity">
				@sidebar.Trigger()
				<h1 title={ p.Window.Archive.FileName }>{ title }</h1>
				<div class="log-mode">
					@button.Button(button.Props{Href: back, Variant: button.VariantOutline, Size: button.SizeSm}) {
						@icon.ArrowLeft(icon.Props{Class: "size-3.5"})
						{ i18n.T(ctx, "logs.back_to_results") }
					}
				</div>
			</header>
			<div class="log-preferences">
				@logDisplay(p.Display)
				@components.LanguageSwitcher()
			</div>
			<div class="log-filters flex flex-wrap items-center justify-between gap-2">
				<span class="min-w-0 truncate text-sm" title={ p.Window.Rows[p.Window.Anchor].Instance }>
					@archiveInstanceName(p.Window.Rows[p.Window.Anchor].Instance)
				</span>
				@button.Button(button.Props{Href: p.ArchivePath + "/context/download?" + download.Encode(), Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"hx-boost": "false", "download": true, "title": i18n.Format(ctx, i18n.Message{ID: "archives.download_neighbours", Data: map[string]any{"Lines": p.Lines}})}}) {
					@icon.Download(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "archives.download_default_context") }
				}
			</div>
			<div id="logs-container" class="flex h-full min-h-0 flex-col">
				@logStream(p.Display, p.ProjectID, p.ClientID, false) {
					@ArchiveContextLines(p, "")
				}
			</div>
		</section>
		@archiveHitMenu(templ.Attributes{
			"data-search-url":    back,
			"data-archive-start": strconv.FormatInt(p.Window.Archive.FromAt.Unix(), 10),
			"data-archive-end":   strconv.FormatInt(p.Window.Archive.ToAt.Unix()+1, 10),
		})
	}
}

templ ArchiveContextLines(p ArchiveContextProps, direction string) {
	{{
		w := p.Window
		start, end := 0, len(w.Rows)
		if direction == "backward" {
			end = w.Anchor
		} else if direction == "forward" {
			start = w.Anchor + 1
		}
	}}
	if direction != "backward" && !w.NewerEdge {
		@logPageControl(p.pageURL(w.Rows[len(w.Rows)-1], "forward"), "forward", "logs.load_newer", "this:drop")
	}
	// The shared viewport uses flex-col-reverse, so emit newest first.
	for i := end - 1; i >= start; i-- {
		{{ hit := w.Rows[i] }}
		@logs.RecordLine(hit.OccurredAt, hit.Instance, hit.Message, logsearch.Query{}, i == w.Anchor, templ.Attributes{"data-archive-row": true}) {
			@archiveActionTrigger(p.ArchivePath, hit, logs.RowActionClass)
		}
	}
	if direction != "forward" && !w.OlderEdge {
		@logPageControl(p.pageURL(w.Rows[0], "backward"), "backward", "logs.load_older", "this:drop")
	}
}
