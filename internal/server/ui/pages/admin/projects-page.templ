package admin

import "fmt"
import "strings"

import "github.com/markojerkic/svarog/internal/lib/projects"
import "github.com/markojerkic/svarog/internal/server/ui/components/button"
import "github.com/markojerkic/svarog/internal/server/ui/components/dropdownmenu"
import "github.com/markojerkic/svarog/internal/server/ui/components/icon"
import "github.com/markojerkic/svarog/internal/server/ui/components/pagination"
import projectcomponents "github.com/markojerkic/svarog/internal/server/ui/components/projects"
import "github.com/markojerkic/svarog/internal/server/ui/components/table"
import "github.com/markojerkic/svarog/internal/server/ui/pages"
import "github.com/markojerkic/svarog/internal/server/ui/components/input"
import "github.com/markojerkic/svarog/internal/server/ui/shadcnutil"
import "github.com/markojerkic/svarog/internal/server/i18n"

type ProjectsListPageProps struct {
	Projects   []projects.Project
	Page       int64
	Size       int64
	Search     string
	TotalCount int64
}

templ ProjectsListPage(props ProjectsListPageProps) {
	@pages.AdminLayout(pages.AdminLayoutProps{Title: i18n.T(ctx, "nav.projects"), CurrentPath: "/admin/projects"}) {
		<div class="mx-auto w-full max-w-6xl space-y-6">
			<div class="flex flex-wrap items-start justify-between gap-4">
				<div class="space-y-1">
					<h1 class="text-2xl font-semibold tracking-tight">{ i18n.T(ctx, "nav.projects") }</h1>
					<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "projects.description") }</p>
				</div>
				@projectcomponents.NewProject()
			</div>
			<div class="relative w-full sm:max-w-xs">
				<span class="pointer-events-none absolute inset-y-0 left-2.5 flex items-center text-muted-foreground">
					@icon.Search(icon.Props{Class: "size-4"})
				</span>
				<form
					id="search-form"
					hx-get="/admin/projects"
					hx-boost="true"
					hx-push-url="true"
					hx-target=".table-wrapper"
					hx-select=".table-wrapper"
					hx-swap="outerHTML"
					hx-trigger="input changed delay:300ms"
				>
					<input type="hidden" name="size" value={ fmt.Sprint(props.Size) }/>
					@input.Input(input.Props{
						Type:        "search",
						Value:       props.Search,
						Name:        "search",
						Class:       "pl-9",
						Placeholder: i18n.T(ctx, "projects.search_placeholder"),
						Attributes:  templ.Attributes{"aria-label": i18n.T(ctx, "projects.search")},
					})
				</form>
			</div>
			<div class="table-wrapper space-y-4">
				<div class="overflow-hidden rounded-xl border">
					@table.Table(table.Props{Class: "table-fixed [&_th]:px-4 [&_td]:px-4 [&_td]:py-3"}) {
						@table.Caption(table.CaptionProps{Class: "sr-only"}) {
							{ i18n.T(ctx, "projects.list_caption") }
						}
						@table.Header(table.HeaderProps{Class: "bg-muted/50"}) {
							@table.Row() {
								@table.Head(table.HeadProps{Class: "w-2/5"}) {
									{ i18n.T(ctx, "projects.name") }
								}
								@table.Head() {
									{ i18n.T(ctx, "projects.clients") }
								}
								@table.Head(table.HeadProps{Class: "w-12"}) {
									<span class="sr-only">{ i18n.T(ctx, "common.actions") }</span>
								}
							}
						}
						@ProjectsTableBody(props)
					}
				</div>
				@projectcomponents.EditProjectDialog()
				<div hx-push-url:inherited="true">
					@pagination.PaginationWrapper(pagination.WrapperProps{
						Page:       props.Page,
						Size:       props.Size,
						TotalCount: props.TotalCount,
						BaseURL:    "/admin/projects",
					})
				</div>
			</div>
			@projectcomponents.ConnectionStringDialog()
		</div>
	}
}

templ ProjectsTableBody(props ProjectsListPageProps) {
	@table.Body(table.BodyProps{
		ID: "projects-list-table-body",
	}) {
		for _, project := range props.Projects {
			@table.Row(table.RowProps{
				Attributes: templ.Attributes{"data-project-id": project.ID.String()},
			}) {
				@table.Cell(table.CellProps{Class: "font-medium"}) {
					<span class="block truncate" title={ project.Name }>{ project.Name }</span>
				}
				@table.Cell(table.CellProps{Class: "text-muted-foreground"}) {
					<span class="block truncate" title={ strings.Join(project.ClientNames(), ", ") }>{ strings.Join(project.ClientNames(), ", ") }</span>
				}
				@table.Cell() {
					@projectActions(project)
				}
			}
		}
		if len(props.Projects) == 0 {
			@table.Row(table.RowProps{Class: "hidden only:table-row"}) {
				@table.Cell(table.CellProps{Class: "h-32 text-center text-muted-foreground", Attributes: templ.Attributes{"colspan": "3"}}) {
					{ i18n.T(ctx, "projects.no_results") }
				}
			}
		}
	}
}

templ projectActions(project projects.Project) {
	@dropdownmenu.DropdownMenu() {
		@button.Button(button.Props{
			Variant:    button.VariantGhost,
			Size:       button.SizeIcon,
			Attributes: utils.MergeAttributes(dropdownmenu.Trigger(ctx), templ.Attributes{"aria-label": i18n.Format(ctx, i18n.Message{ID: "projects.actions_for", Data: map[string]any{"Name": project.Name}})}),
		}) {
			@icon.EllipsisVertical()
		}
		@dropdownmenu.Content(dropdownmenu.ContentProps{
			Class: "w-56",
		}) {
			@dropdownmenu.Group() {
				@dropdownmenu.Item(dropdownmenu.ItemProps{
					Attributes: templ.Attributes{
						"hx-get":    "/admin/projects/" + project.ID.String() + "/edit",
						"hx-target": "#edit-project-form-container",
						"hx-swap":   "innerHTML",
						"onclick":   "window.templ.dialog.open('edit-project-dialog')",
					},
				}) {
					<span class="flex items-center">
						@icon.Pencil(icon.Props{Size: 16, Class: "mr-2"})
						{ i18n.T(ctx, "common.edit") }
					</span>
				}
				@dropdownmenu.Item(dropdownmenu.ItemProps{
					Attributes: templ.Attributes{
						"hx-delete":  "/admin/projects/" + project.ID.String(),
						"hx-confirm": i18n.T(ctx, "projects.delete_confirm"),
						"hx-target":  fmt.Sprintf("tr[data-project-id='%s']", project.ID.String()),
						"hx-disable": "input, button, #new-project-dialog > button[type=submit]",
					},
				}) {
					<span class="flex items-center">
						@icon.Minus(icon.Props{Size: 16, Class: "mr-2"})
						{ i18n.T(ctx, "projects.delete") }
					</span>
				}
				@dropdownmenu.Item(dropdownmenu.ItemProps{
					Attributes: templ.Attributes{
						"hx-get":    "/admin/projects/" + project.ID.String() + "/connection-string-form",
						"hx-target": "#connection-string-form-container",
						"hx-swap":   "innerHTML",
						"onclick":   "window.templ.dialog.open('connection-string-dialog')",
					},
				}) {
					<span class="inline-flex flex-wrap items-center whitespace-normal [&>span]:flex [&>span]:items-center">
						@icon.Code(icon.Props{Size: 16, Class: "mr-2 shrink-0"})
						{ i18n.T(ctx, "connection.title") }
					</span>
				}
			}
		}
	}
}
