package admin

import "github.com/markojerkic/svarog/internal/server/ui/pages"
import "github.com/markojerkic/svarog/internal/server/ui/components/table"
import "github.com/markojerkic/svarog/internal/server/ui/components/dropdownmenu"
import "github.com/markojerkic/svarog/internal/server/ui/components/button"
import "github.com/markojerkic/svarog/internal/server/ui/components/icon"
import "github.com/markojerkic/svarog/internal/server/ui/components/pagination"
import "fmt"
import "github.com/markojerkic/svarog/internal/lib/auth"
import "github.com/markojerkic/svarog/internal/server/http/htmx"
import usercomponents "github.com/markojerkic/svarog/internal/server/ui/components/users"
import "github.com/markojerkic/svarog/internal/server/ui/components/input"
import "github.com/markojerkic/svarog/internal/server/ui/components/badge"
import "github.com/markojerkic/svarog/internal/server/i18n"

type UsersListPageProps struct {
	Users      []auth.User
	Page       int64
	Size       int64
	Search     string
	TotalCount int64
}

templ UsersListPage(props UsersListPageProps) {
	@pages.AdminLayout(pages.AdminLayoutProps{Title: i18n.T(ctx, "nav.users"), CurrentPath: "/admin/users"}) {
		<div class="mx-auto w-full max-w-6xl space-y-6">
			<div class="flex flex-wrap items-start justify-between gap-4">
				<div class="space-y-1">
					<h1 class="text-2xl font-semibold tracking-tight">{ i18n.T(ctx, "nav.users") }</h1>
					<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "users.description") }</p>
				</div>
				@usercomponents.NewUser()
			</div>
			<div class="relative w-full sm:max-w-xs">
				<span class="pointer-events-none absolute inset-y-0 left-2.5 flex items-center text-muted-foreground">
					@icon.Search(icon.Props{Class: "size-4"})
				</span>
				<form
					id="search-form"
					hx-get="/admin/users"
					hx-boost="true"
					hx-push-url="true"
					hx-target=".table-wrapper"
					hx-select=".table-wrapper"
					hx-swap="outerHTML"
					hx-trigger="input changed delay:300ms"
				>
					@input.Input(input.Props{
						Type:        "search",
						Value:       props.Search,
						Name:        "search",
						Class:       "pl-9",
						Placeholder: i18n.T(ctx, "users.search_placeholder"),
						Attributes:  templ.Attributes{"aria-label": i18n.T(ctx, "users.search")},
					})
				</form>
			</div>
			<div class="table-wrapper space-y-4">
				<div class="overflow-hidden rounded-xl border">
					@table.Table(table.Props{Class: "[&_th]:px-4 [&_td]:px-4 [&_td]:py-3"}) {
						@table.Caption(table.CaptionProps{Class: "sr-only"}) {
							{ i18n.T(ctx, "users.list_caption") }
						}
						@table.Header(table.HeaderProps{Class: "bg-muted/50"}) {
							@table.Row() {
								@table.Head() {
									{ i18n.T(ctx, "auth.username") }
								}
								@table.Head() {
									{ i18n.T(ctx, "users.name") }
								}
								@table.Head() {
									{ i18n.T(ctx, "users.role") }
								}
								@table.Head(table.HeadProps{Class: "w-12"}) {
									<span class="sr-only">{ i18n.T(ctx, "common.actions") }</span>
								}
							}
						}
						@UsersTableBody(props)
					}
				</div>
				@usercomponents.EditUserDialog()
				@pagination.PaginationWrapper(pagination.WrapperProps{
					Page:       props.Page,
					Size:       props.Size,
					TotalCount: props.TotalCount,
					BaseURL:    "/admin/users",
				})
			</div>
		</div>
	}
}

templ UsersTableBody(props UsersListPageProps) {
	@table.Body(table.BodyProps{
		ID: "users-list-table-body",
	}) {
		for _, user := range props.Users {
			@table.Row(table.RowProps{
				Attributes: templ.Attributes{"data-user-id": user.ID.String()},
			}) {
				@table.Cell(table.CellProps{Class: "font-medium"}) {
					{ user.Username }
				}
				@table.Cell(table.CellProps{Class: "text-muted-foreground"}) {
					{ user.FirstName + " " + user.LastName }
				}
				@table.Cell() {
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
						if user.Role == auth.ADMIN {
							{ i18n.T(ctx, "users.role_admin") }
						} else {
							{ i18n.T(ctx, "users.role_user") }
						}
					}
				}
				@table.Cell() {
					@userActions(user)
				}
			}
		}
		if len(props.Users) == 0 {
			@table.Row(table.RowProps{Class: "hidden only:table-row"}) {
				@table.Cell(table.CellProps{Class: "h-32 text-center text-muted-foreground", Attributes: templ.Attributes{"colspan": "4"}}) {
					{ i18n.T(ctx, "users.no_results") }
				}
			}
		}
	}
}

templ userActions(user auth.User) {
	@dropdownmenu.DropdownMenu() {
		{{
			trigger := dropdownmenu.Trigger(ctx)
			trigger["data-user-actions-id"] = user.ID.String()
			trigger["aria-label"] = i18n.Format(ctx, i18n.Message{ID: "users.actions_for", Data: map[string]any{"Username": user.Username}})
		}}
		@button.Button(button.Props{
			Variant:    button.VariantGhost,
			Size:       button.SizeIcon,
			Attributes: trigger,
		}) {
			<span
				class="svarog-indicator"
				data-indicator-user-id={ user.ID.String() }
				data-fallback
			>
				@icon.EllipsisVertical()
			</span>
			<span
				class="svarog-indicator animate-spin"
				data-indicator-user-id={ user.ID.String() }
			>
				@icon.LoaderCircle(icon.Props{Size: 16})
			</span>
		}
		@dropdownmenu.Content(dropdownmenu.ContentProps{
			Class: "w-56",
		}) {
			@dropdownmenu.Group() {
				@dropdownmenu.Item(dropdownmenu.ItemProps{
					Attributes: templ.Attributes{
						"hx-get":     "/admin/users/" + user.ID.String() + "/edit",
						"hx-target":  "#edit-user-form-container",
						"hx-swap":    "innerHTML",
						"onclick":    "window.templ.dialog.open('edit-user-dialog')",
						"hx-disable": "#edit-user-dialog button[type=submit], #edit-user-dialog input",
					},
				}) {
					<span class="flex items-center">
						@icon.Pencil(icon.Props{Size: 16, Class: "mr-2"})
						{ i18n.T(ctx, "common.edit") }
					</span>
				}
				@dropdownmenu.Item(dropdownmenu.ItemProps{
					Attributes: templ.Attributes{
						"hx-delete":  "/admin/users/" + user.ID.String(),
						"hx-confirm": i18n.T(ctx, "users.delete_confirm"),
						"hx-target":  fmt.Sprintf("tr[data-user-id='%s']", user.ID.String()),
						"hx-disable": "input, button, #new-user-dialog button[type=submit]",
					},
				}) {
					<span class="flex items-center">
						@icon.Minus(icon.Props{Size: 16, Class: "mr-2"})
						{ i18n.T(ctx, "users.delete") }
					</span>
				}
				@dropdownmenu.Item(dropdownmenu.ItemProps{
					Attributes: templ.Attributes{
						"hx-post": "/admin/users/generate-login-token",
						"hx-swap": "none",
						"hx-vals": htmx.HxVals(map[string]string{
							"userId": user.ID.String(),
						}),
						"hx-indicator": fmt.Sprintf(".svarog-indicator[data-indicator-user-id='%s']", user.ID.String()),
						"hx-disable":   fmt.Sprintf("[data-user-actions-id='%s']", user.ID.String()),
					},
				}) {
					<span class="inline-flex flex-wrap items-center whitespace-normal [&>span]:flex [&>span]:items-center">
						@icon.Code(icon.Props{Size: 16, Class: "mr-2 shrink-0"})
						{ i18n.T(ctx, "users.login_link") }
					</span>
				}
			}
		}
	}
}
