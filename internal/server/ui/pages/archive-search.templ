package pages

import "context"
import "net/url"
import "strconv"
import "github.com/markojerkic/svarog/internal/lib/archive"
import "github.com/markojerkic/svarog/internal/lib/logsearch"
import "github.com/markojerkic/svarog/internal/server/i18n"
import "github.com/markojerkic/svarog/internal/server/ui/components/archives"
import "github.com/markojerkic/svarog/internal/server/ui/components/button"
import "github.com/markojerkic/svarog/internal/server/ui/components/icon"
import "github.com/markojerkic/svarog/internal/server/ui/components/input"
import "github.com/markojerkic/svarog/internal/server/ui/components/logs"
import "github.com/markojerkic/svarog/internal/server/ui/components/popover"

type ArchiveSearchProps struct {
	ProjectID, ClientID string
	FromUnix, ToUnix    string
	Text                string
	Instance            *string
	Query               logsearch.Query
	ErrorKey            string
	Result              *archive.SearchResult
	Display             LogDisplayOptions
}

func (p ArchiveSearchProps) searchURL(cursor string) string {
	params := url.Values{"from": {p.FromUnix}, "to": {p.ToUnix}, "text": {p.Text}}
	if p.Instance != nil {
		params.Set("instance", *p.Instance)
	}
	if cursor != "" {
		params.Set("older_cursor", cursor)
	}
	return archives.ArchivePanelURL(p.ProjectID, p.ClientID) + "/search?" + params.Encode()
}

templ ArchiveSearch(p ArchiveSearchProps) {
	{{ logPath := "/logs/" + p.ProjectID + "/" + p.ClientID }}
	@adminShell(AdminLayoutProps{Title: i18n.T(ctx, "archives.search"), CurrentPath: logPath}) {
		<section class="log-workspace">
			@logWorkspaceHeader(i18n.T(ctx, "archives.search"), p.Display, archives.Trigger(p.ProjectID, p.ClientID)) {
				@button.Button(button.Props{Href: logPath, Variant: button.VariantGhost, Size: button.SizeSm}) {
					@icon.Radio(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "logs.back_to_live") }
				}
			}
			<form
				id="archive-search-form"
				method="get"
				action={ templ.SafeURL(archives.ArchivePanelURL(p.ProjectID, p.ClientID) + "/search") }
				hx-boost="true"
				hx-target="#archive-search-results"
				hx-swap="innerHTML show:none"
				hx-push-url="true"
				hx-sync="this:replace"
				hx-disable="#log-search-dialog button[type='submit'], [data-archive-range-done]"
				hx-indicator:append="this"
				class="log-filters group"
				aria-label={ i18n.T(ctx, "logs.filters") }
			>
				<input type="hidden" name="from" value={ p.FromUnix }/>
				<input type="hidden" name="to" value={ p.ToUnix }/>
				@logFilterToggle(p.filterLabels(ctx))
				<div id="log-filter-fields">
					@archiveQueryControl(p, false)
					<div class="log-filter-field">
						<span class="log-field-label">{ i18n.T(ctx, "logs.date_range") }</span>
						<div class="log-field-control">
							@logRangePopover("archive-range", i18n.T(ctx, "logs.date_range"), popover.AlignStart, button.SizeSm) {
								<div class="flex flex-wrap gap-1">
									@LogRangePreset("15", i18n.T(ctx, "logs.last_15_minutes"))
									@LogRangePreset("60", i18n.T(ctx, "logs.last_hour"))
									@LogRangePreset("today", i18n.T(ctx, "logs.today"))
								</div>
								<details class="text-sm">
									<summary class="cursor-pointer">{ i18n.T(ctx, "logs.precise_range") }</summary>
									<div class="mt-2 flex flex-wrap gap-2">
										<label>
											{ i18n.T(ctx, "logs.time_from") }
											@input.Input(input.Props{Type: "time", ID: "archive-from-time", Form: "archive-search-form", Attributes: templ.Attributes{"step": "1"}})
										</label>
										<label>
											{ i18n.T(ctx, "logs.time_to") }
											@input.Input(input.Props{Type: "time", ID: "archive-to-time", Form: "archive-search-form", Attributes: templ.Attributes{"step": "1"}})
										</label>
									</div>
								</details>
								@logRangeCalendar("", "")
								@button.Button(button.Props{Type: button.TypeButton, Size: button.SizeSm, Class: "self-end", Attributes: templ.Attributes{"data-archive-range-done": true}}) {
									{ i18n.T(ctx, "logs.apply_dates") }
								}
							}
						</div>
					</div>
					@archiveInstanceControl(p, false)
					<span role="status" class="hidden items-center gap-1.5 text-xs text-muted-foreground group-[.htmx-request]:inline-flex">
						@icon.LoaderCircle(icon.Props{Class: "size-3.5 animate-spin motion-reduce:animate-none"})
						{ i18n.T(ctx, "logs.searching") }
					</span>
				</div>
				<p id="archive-range-error" role="alert" hidden class="mt-2 text-sm text-destructive">{ i18n.T(ctx, "archives.range_required") }</p>
			</form>
			<div id="logs-container" class="flex h-full min-h-0 flex-col">
				<div id="archive-search-results" class="flex min-h-0 flex-1 flex-col gap-2">
					@ArchiveSearchResults(p)
				</div>
			</div>
		</section>
		@logs.SearchDialogShell() {
			<div class="flex items-center gap-4 px-4 sm:px-5">
				@logs.SearchBox("archive-search-form", "text", p.Text, templ.Attributes{"maxlength": archive.MaxSearchText})
			</div>
		}
		@archives.SettingsSheet()
		@archiveHitMenu()
	}
}

func (p ArchiveSearchProps) filterLabels(ctx context.Context) []string {
	var labels []string
	if p.Text != "" {
		labels = append(labels, p.Text)
	}
	if p.FromUnix != "" {
		labels = append(labels, i18n.T(ctx, "logs.date_range"))
	}
	if p.Instance != nil {
		labels = append(labels, logInstanceLabel(ctx, *p.Instance))
	}
	return labels
}

templ archiveQueryControl(p ArchiveSearchProps, update bool) {
	<div
		id="archive-query-control"
		class="log-filter-field log-search-field"
		if update {
			hx-swap-oob="outerHTML"
		}
	>
		<span class="log-field-label">{ i18n.T(ctx, "logs.search") }</span>
		<div class="log-field-control">
			@logs.SearchTrigger(p.Text)
			if p.Text != "" {
				<button type="button" class="log-clear" data-archive-clear-text aria-label={ i18n.T(ctx, "logs.clear_search") }>
					@icon.X(icon.Props{Size: 13})
				</button>
			}
		</div>
	</div>
}

templ archiveInstanceControl(p ArchiveSearchProps, update bool) {
	<div
		id="archive-instance-control"
		class="log-filter-field"
		if update {
			hx-swap-oob="outerHTML"
		}
	>
		<input
			type="hidden"
			name="instance"
			disabled?={ p.Instance == nil }
			if p.Instance != nil {
				value={ *p.Instance }
			}
		/>
		<span class="log-field-label">{ i18n.T(ctx, "logs.instances") }</span>
		@popover.Popover(popover.Props{ID: "archive-instance-picker"}) {
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Class: "max-w-full", Attributes: popover.Trigger(ctx)}) {
				@icon.Server(icon.Props{Class: "size-3.5"})
				if p.Instance == nil {
					{ i18n.T(ctx,"logs.all_instances") }
				} else {
					<span class="truncate">@archiveInstanceName(*p.Instance)</span>
				}
			}
			@popover.Content(popover.ContentProps{Align: popover.AlignStart, Class: "w-80 max-w-[calc(100vw-2rem)] gap-2 p-3"}) {
				@popover.Title(popover.TitleProps{Class: "text-sm font-medium"}) {
					{ i18n.T(ctx, "logs.instances") }
				}
				if p.Result != nil && len(p.Result.Instances) > 0 {
					<input id="archive-instance-name" type="search" aria-label={ i18n.T(ctx, "logs.find_instance") } placeholder={ i18n.T(ctx, "logs.find_instance") } class="w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm"/>
					<div class="max-h-56 overflow-y-auto overscroll-contain">
						for _, name := range p.Result.Instances {
							<button type="button" data-archive-instance value={ name } aria-pressed={ strconv.FormatBool(p.Instance != nil && *p.Instance == name) } class="flex w-full items-center justify-between gap-2 rounded-md px-2 py-1.5 text-left text-sm hover:bg-accent aria-pressed:bg-accent">
								<span class="wrap-anywhere">@archiveInstanceName(name)</span>
								if p.Instance != nil && *p.Instance == name {
									@icon.Check(icon.Props{Size: 14, Class: "shrink-0"})
								}
							</button>
						}
					</div>
					<p data-archive-no-instances hidden role="status" class="text-xs text-muted-foreground">{ i18n.T(ctx, "logs.no_instances_found") }</p>
				} else if p.FromUnix == "" {
					<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "archives.range_required") }</p>
				} else {
					<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "logs.no_instances_found") }</p>
				}
				if p.Instance != nil {
					@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Attributes: templ.Attributes{"data-archive-all-instances": true}}) {
						{ i18n.T(ctx, "logs.all_instances") }
					}
				}
			}
		}
	</div>
}

templ ArchiveSearchResponse(p ArchiveSearchProps) {
	@archiveQueryControl(p, true)
	@archiveInstanceControl(p, true)
	@logFilterSummary(p.filterLabels(ctx), true)
	@ArchiveSearchResults(p)
}

templ ArchiveSearchResults(p ArchiveSearchProps) {
	if p.ErrorKey != "" {
		<p role="alert" class="rounded-lg border border-destructive/40 p-4 text-sm">{ i18n.T(ctx, p.ErrorKey) }</p>
	} else {
		<h2 id="archive-results" class="sr-only">{ i18n.T(ctx, "logs.search_results") }</h2>
		if p.Result != nil && p.Result.ArchivesScanned > 0 {
			@archiveSearchSummary(p.Result, false)
		}
		@logStream(p.Display, p.ProjectID, p.ClientID, false) {
			if p.Result == nil || len(p.Result.Hits) == 0 {
				<div class="m-auto px-4 py-12 text-center font-sans text-sm text-muted-foreground" role="status">
					if p.Result == nil {
						{ i18n.T(ctx,"archives.search_hint") }
					} else if p.Result.ArchivesScanned == 0 {
						{ i18n.T(ctx,"archives.search_no_archives") }
					} else {
						{ i18n.T(ctx,"logs.no_results") }
					}
				</div>
			} else {
				@archiveSearchRows(p)
			}
		}
	}
}

templ archiveSearchSummary(result *archive.SearchResult, update bool) {
	<p
		id="archive-search-summary"
		aria-live="polite"
		class="text-sm text-muted-foreground"
		if update {
			hx-swap-oob="outerHTML"
		}
	>{ i18n.Format(ctx, i18n.Message{ID: "archives.search_summary", Data: map[string]any{"Archives": result.ArchivesScanned, "Shown": result.Skipped + len(result.Hits), "Total": result.TotalMatches}}) }</p>
}

// A continuation replaces only the pager at the end of the list.
templ ArchiveSearchMore(p ArchiveSearchProps) {
	if p.ErrorKey != "" {
		<div class="space-y-1 px-4 py-3 font-sans">
			<p role="alert" class="text-sm">{ i18n.T(ctx, p.ErrorKey) }</p>
			<a href={ templ.SafeURL(p.searchURL("")) } hx-boost="true" hx-target="body" class="text-sm underline">{ i18n.T(ctx, "archives.search_restart") }</a>
		</div>
	} else {
		@archiveSearchSummary(p.Result, true)
		@archiveSearchRows(p)
	}
}

templ archiveSearchRows(p ArchiveSearchProps) {
	for _, hit := range p.Result.Hits {
		@logs.RecordLine(hit.OccurredAt, hit.Instance, hit.Message, p.Query, false, templ.Attributes{"data-archive-row": true}) {
			@archiveActionTrigger(archives.ArchiveDownloadURL(p.ProjectID, p.ClientID, hit.ArchiveID.String()), hit, logs.RowActionClass)
		}
	}
	if p.Result.OlderCursor != "" {
		<div class="flex shrink-0 justify-center py-1 font-sans" data-archive-search-page data-log-page="backward">
			@button.Button(button.Props{
				ID: "archive-search-older", Type: button.TypeButton, Variant: button.VariantOutline,
				Attributes: templ.Attributes{
					"hx-get": p.searchURL(p.Result.OlderCursor), "hx-target": "closest [data-archive-search-page]", "hx-swap": "outerHTML show:none",
					"hx-sync": "#archive-search-form:drop", "hx-disable": "this",
				},
			}) {
				{ i18n.T(ctx, "archives.search_older") }
			}
		</div>
	}
}

templ archiveActionTrigger(archiveURL string, hit archive.SearchHit, class string) {
	@button.Button(button.Props{
		Variant: button.VariantGhost, Size: button.SizeIconXs, Class: class,
		Attributes: templ.Attributes{
			"aria-label": i18n.T(ctx, "logs.line_actions"), "popovertarget": "archive-hit-menu",
			"data-archive-url": archiveURL, "data-entry": hit.Entry, "data-line": strconv.Itoa(hit.Line), "data-instance": hit.Instance,
		},
	}) {
		@icon.EllipsisVertical(icon.Props{Size: 16})
	}
}

templ archiveInstanceName(name string) {
	if name == "" {
		{ i18n.T(ctx, "logs.unnamed_instance") }
	} else {
		{ name }
	}
}

templ archiveHitMenu(attributes ...templ.Attributes) {
	{{ item := "flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-left text-sm hover:bg-accent focus-visible:bg-accent focus-visible:outline-none" }}
	<div
		popover="auto"
		id="archive-hit-menu"
		class="fixed inset-auto m-0 w-max max-w-[calc(100vw-1rem)] rounded-lg border bg-popover p-1 text-popover-foreground shadow-md"
		aria-label={ i18n.T(ctx, "logs.line_actions") }
		if len(attributes) > 0 {
			{ attributes[0]... }
		}
	>
		<a data-action="context" class={ item } hx-boost="true">
			@icon.ListTree(icon.Props{Size: 15})
			{ i18n.T(ctx, "logs.open_context") }
		</a>
		<a data-action="instance" class={ item } hx-boost="true" hx-swap="innerHTML show:none">
			@icon.Funnel(icon.Props{Size: 15})
			{ i18n.T(ctx, "logs.only_this_instance") }
		</a>
		<hr class="my-1 border-border"/>
		<a data-action="download" class={ item } hx-boost="false" download>
			@icon.FileText(icon.Props{Size: 15})
			{ i18n.T(ctx, "archives.download_default_context") }
		</a>
		<a data-action="zip" class={ item } hx-boost="false" download>
			@icon.Archive(icon.Props{Size: 15})
			{ i18n.T(ctx, "archives.download_zip") }
		</a>
		<hr class="my-1 border-border"/>
		<button type="button" data-action="copy" class={ item }>
			@icon.Copy(icon.Props{Size: 15})
			{ i18n.T(ctx, "logs.copy_line") }
		</button>
		<button type="button" data-action="link" class={ item }>
			@icon.Link(icon.Props{Size: 15})
			{ i18n.T(ctx, "logs.copy_link") }
		</button>
	</div>
}
