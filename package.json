{
  "name": "svarog",
  "private": true,
  "scripts": {
    "tw": "./node_modules/@tailwindcss/cli/dist/index.mjs -i internal/server/ui/assets/css/input.css -o internal/server/ui/assets/css/output.css --watch",
    "tw:build": "./node_modules/@tailwindcss/cli/dist/index.mjs -i internal/server/ui/assets/css/input.css -o internal/server/ui/assets/css/output.css",
    "playwright:setup": "playwright install chromium",
    "test": "playwright test ./tests",
    "prepare": "husky"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.3",
    "htmx.org": "4.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@parcel/watcher": "2.6.0"
  },
  "lint-staged": {
    "*.{js,css,json,md}": "oxfmt",
    "*.go": [
      "go tool goimports -w",
      "gofmt -w"
    ],
    "*.templ": "templ fmt"
  },
  "packageManager": "bun@1.4.3"
}
