# Paste each client's connection URL from the Svarog UI (NATS, not HTTP).
API_CONN_STRING=
WORKER_CONN_STRING=
PAYMENTS_CONN_STRING=

API_REPLICAS=3
WORKER_REPLICAS=2
PAYMENTS_REPLICAS=2

# One message per interval per replica.
DEMO_INTERVAL=1s

# Linux local dev: NATS is bound to 127.0.0.1:4222.
# For a remote dev server, bridge networking is sufficient.
DEMO_NETWORK_MODE=host
