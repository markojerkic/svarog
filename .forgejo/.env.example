POSTGRES_URL='postgres://svarog:replace-me@host.docker.internal:5432/svarog?sslmode=disable'
SESSION_SECRET=replace-with-a-long-random-value

NATS_ACCOUNT_SEED=
NATS_SERVER_USER_JWT=
NATS_SERVER_USER_SEED=
NATS_PUBLIC_ADDR=logs.example.com:4222

SVAROG_HTTP_BIND=127.0.0.1
SVAROG_HTTP_PORT=1323
SVAROG_NATS_BIND=0.0.0.0
SVAROG_NATS_PORT=4222
ARCHIVE_SCHEDULER_ENABLED=true

# Server self-logging: paste the client URL from the UI, using nats:4222 as the host.
# Empty connection URL = console only; empty instance ID = container hostname.
LOG_LEVEL=info
SVAROG_CONN_STRING=
SVAROG_INSTANCE_ID=
